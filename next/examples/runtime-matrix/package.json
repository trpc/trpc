{
  "name": "@example/runtime-matrix",
  "private": true,
  "type": "module",
  "scripts": {
    "start": "node start.ts",
    "start:node": "node start.ts node",
    "start:bun": "node start.ts bun",
    "start:deno": "node start.ts deno",
    "start:lambda": "node start.ts lambda",
    "start:workers": "node start.ts workers",
    "server": "node server.ts",
    "server:bun": "bun bun/server.ts",
    "server:bun-effect": "bun bun/effect-server.ts",
    "server:deno": "deno run --no-lock --allow-net --allow-env --allow-read deno/server.ts",
    "server:lambda": "node lambda/function-url.ts",
    "server:workers": "wrangler dev",
    "client": "node client.ts",
    "smoke": "pnpm start",
    "typecheck": "tsc --noEmit -p tsconfig.json && tsc --noEmit -p tsconfig.bun.json && tsc --noEmit -p tsconfig.deno.json && tsc --noEmit -p tsconfig.worker.json",
    "deploy": "wrangler deploy"
  },
  "dependencies": {
    "@effect/platform-bun": "4.1.1",
    "@effect/platform-node": "4.1.1",
    "@trpc12/trpc": "workspace:*",
    "effect": "4.1.1",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "5.20261014.1",
    "@types/bun": "1.4.3",
    "@types/node": "^26.0.0",
    "typescript": "7.1.0-beta",
    "wrangler": "4.151.0"
  }
}
