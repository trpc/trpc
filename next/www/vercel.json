{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "buildCommand": "pnpm build",
  "framework": "tanstack-start",
  "git": {
    "deploymentEnabled": {
      "**": false,
      "v12": true,
      "v12-*": true
    }
  },
  "ignoreCommand": "sh ../tooling/vercel-ignore/ignore.sh",
  "installCommand": "pnpm install --frozen-lockfile"
}
