{
  "openapi": "3.1.1",
  "info": {
    "title": "Blog",
    "version": "1.0.0"
  },
  "servers": [
    {
      "url": "http://localhost:3000"
    }
  ],
  "paths": {
    "/api/posts/{id}": {
      "get": {
        "operationId": "post.byId",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "id": {
                      "type": "string"
                    },
                    "title": {
                      "type": "string"
                    },
                    "author": {
                      "type": [
                        "string",
                        "null"
                      ]
                    },
                    "createdAt": {
                      "type": "string",
                      "format": "date-time"
                    }
                  },
                  "required": [
                    "id",
                    "title",
                    "author",
                    "createdAt"
                  ],
                  "additionalProperties": false
                }
              }
            }
          },
          "400": {
            "description": "BAD_REQUEST",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "defined": {
                      "const": true
                    },
                    "code": {
                      "const": "BAD_REQUEST"
                    },
                    "message": {
                      "type": "string"
                    },
                    "data": {
                      "type": "object",
                      "properties": {
                        "issues": {
                          "type": "array",
                          "items": {
                            "type": "object",
                            "properties": {
                              "message": {
                                "type": "string"
                              },
                              "path": {
                                "type": "array",
                                "items": {
                                  "type": [
                                    "string",
                                    "number"
                                  ]
                                }
                              }
                            },
                            "required": [
                              "message"
                            ]
                          }
                        }
                      },
                      "required": [
                        "issues"
                      ]
                    }
                  },
                  "required": [
                    "defined",
                    "code",
                    "message",
                    "data"
                  ]
                }
              }
            }
          },
          "404": {
            "description": "NOT_FOUND",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "defined": {
                      "const": true
                    },
                    "code": {
                      "const": "NOT_FOUND"
                    },
                    "message": {
                      "type": "string"
                    },
                    "data": {
                      "type": "object",
                      "properties": {
                        "id": {
                          "type": "string"
                        }
                      },
                      "required": [
                        "id"
                      ],
                      "additionalProperties": false
                    }
                  },
                  "required": [
                    "defined",
                    "code",
                    "message",
                    "data"
                  ]
                }
              }
            }
          },
          "default": {
            "description": "An untyped error, or a typed one with another built-in code",
            "content": {
              "application/json": {
                "schema": {
                  "anyOf": [
                    {
                      "$ref": "#/components/schemas/TrpcUntypedError"
                    },
                    {
                      "type": "object",
                      "properties": {
                        "defined": {
                          "const": true
                        },
                        "code": {
                          "enum": [
                            "PARSE_ERROR",
                            "UNSUPPORTED_PROTOCOL",
                            "UNAUTHORIZED",
                            "PAYMENT_REQUIRED",
                            "FORBIDDEN",
                            "METHOD_NOT_SUPPORTED",
                            "TIMEOUT",
                            "CONFLICT",
                            "PRECONDITION_FAILED",
                            "PAYLOAD_TOO_LARGE",
                            "UNSUPPORTED_MEDIA_TYPE",
                            "UNPROCESSABLE_CONTENT",
                            "TOO_MANY_REQUESTS",
                            "CLIENT_CLOSED_REQUEST",
                            "INTERNAL_SERVER_ERROR",
                            "NOT_IMPLEMENTED",
                            "BAD_GATEWAY",
                            "SERVICE_UNAVAILABLE",
                            "GATEWAY_TIMEOUT"
                          ]
                        },
                        "message": {
                          "type": "string"
                        },
                        "data": {}
                      },
                      "required": [
                        "defined",
                        "code",
                        "message"
                      ]
                    }
                  ]
                }
              }
            }
          }
        }
      }
    },
    "/api/posts": {
      "post": {
        "operationId": "post.create",
        "requestBody": {
          "required": true,
          "content": {
            "multipart/form-data": {
              "schema": {
                "type": "object",
                "properties": {
                  "title": {
                    "type": "string",
                    "minLength": 1
                  },
                  "cover": {
                    "type": "string",
                    "format": "binary",
                    "contentEncoding": "binary"
                  }
                },
                "required": [
                  "title"
                ]
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "id": {
                      "type": "string"
                    },
                    "title": {
                      "type": "string"
                    },
                    "author": {
                      "type": [
                        "string",
                        "null"
                      ]
                    },
                    "createdAt": {
                      "type": "string",
                      "format": "date-time"
                    }
                  },
                  "required": [
                    "id",
                    "title",
                    "author",
                    "createdAt"
                  ],
                  "additionalProperties": false
                }
              }
            }
          },
          "400": {
            "description": "BAD_REQUEST",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "defined": {
                      "const": true
                    },
                    "code": {
                      "const": "BAD_REQUEST"
                    },
                    "message": {
                      "type": "string"
                    },
                    "data": {
                      "type": "object",
                      "properties": {
                        "issues": {
                          "type": "array",
                          "items": {
                            "type": "object",
                            "properties": {
                              "message": {
                                "type": "string"
                              },
                              "path": {
                                "type": "array",
                                "items": {
                                  "type": [
                                    "string",
                                    "number"
                                  ]
                                }
                              }
                            },
                            "required": [
                              "message"
                            ]
                          }
                        }
                      },
                      "required": [
                        "issues"
                      ]
                    }
                  },
                  "required": [
                    "defined",
                    "code",
                    "message",
                    "data"
                  ]
                }
              }
            }
          },
          "default": {
            "description": "An untyped error, or a typed one with another built-in code",
            "content": {
              "application/json": {
                "schema": {
                  "anyOf": [
                    {
                      "$ref": "#/components/schemas/TrpcUntypedError"
                    },
                    {
                      "type": "object",
                      "properties": {
                        "defined": {
                          "const": true
                        },
                        "code": {
                          "enum": [
                            "PARSE_ERROR",
                            "UNSUPPORTED_PROTOCOL",
                            "UNAUTHORIZED",
                            "PAYMENT_REQUIRED",
                            "FORBIDDEN",
                            "NOT_FOUND",
                            "METHOD_NOT_SUPPORTED",
                            "TIMEOUT",
                            "CONFLICT",
                            "PRECONDITION_FAILED",
                            "PAYLOAD_TOO_LARGE",
                            "UNSUPPORTED_MEDIA_TYPE",
                            "UNPROCESSABLE_CONTENT",
                            "TOO_MANY_REQUESTS",
                            "CLIENT_CLOSED_REQUEST",
                            "INTERNAL_SERVER_ERROR",
                            "NOT_IMPLEMENTED",
                            "BAD_GATEWAY",
                            "SERVICE_UNAVAILABLE",
                            "GATEWAY_TIMEOUT"
                          ]
                        },
                        "message": {
                          "type": "string"
                        },
                        "data": {}
                      },
                      "required": [
                        "defined",
                        "code",
                        "message"
                      ]
                    }
                  ]
                }
              }
            }
          }
        },
        "security": [
          {
            "bearer": []
          }
        ]
      }
    },
    "/api/posts/events": {
      "get": {
        "operationId": "post.onAdd",
        "responses": {
          "200": {
            "description": "A stream of server-sent events. Each `message` event carries one event as JSON; `id` is set for `tracked()` events.",
            "content": {
              "text/event-stream": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "id": {
                      "type": "string"
                    },
                    "title": {
                      "type": "string"
                    },
                    "author": {
                      "type": [
                        "string",
                        "null"
                      ]
                    },
                    "createdAt": {
                      "type": "string",
                      "format": "date-time"
                    }
                  },
                  "required": [
                    "id",
                    "title",
                    "author",
                    "createdAt"
                  ],
                  "additionalProperties": false
                }
              }
            }
          },
          "default": {
            "description": "An untyped error, or a typed one with another built-in code",
            "content": {
              "application/json": {
                "schema": {
                  "anyOf": [
                    {
                      "$ref": "#/components/schemas/TrpcUntypedError"
                    },
                    {
                      "type": "object",
                      "properties": {
                        "defined": {
                          "const": true
                        },
                        "code": {
                          "enum": [
                            "PARSE_ERROR",
                            "BAD_REQUEST",
                            "UNSUPPORTED_PROTOCOL",
                            "UNAUTHORIZED",
                            "PAYMENT_REQUIRED",
                            "FORBIDDEN",
                            "NOT_FOUND",
                            "METHOD_NOT_SUPPORTED",
                            "TIMEOUT",
                            "CONFLICT",
                            "PRECONDITION_FAILED",
                            "PAYLOAD_TOO_LARGE",
                            "UNSUPPORTED_MEDIA_TYPE",
                            "UNPROCESSABLE_CONTENT",
                            "TOO_MANY_REQUESTS",
                            "CLIENT_CLOSED_REQUEST",
                            "INTERNAL_SERVER_ERROR",
                            "NOT_IMPLEMENTED",
                            "BAD_GATEWAY",
                            "SERVICE_UNAVAILABLE",
                            "GATEWAY_TIMEOUT"
                          ]
                        },
                        "message": {
                          "type": "string"
                        },
                        "data": {}
                      },
                      "required": [
                        "defined",
                        "code",
                        "message"
                      ]
                    }
                  ]
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "securitySchemes": {
      "bearer": {
        "type": "http",
        "scheme": "bearer"
      }
    },
    "schemas": {
      "TrpcUntypedError": {
        "type": "object",
        "properties": {
          "defined": {
            "const": false
          },
          "code": {
            "type": "string"
          },
          "message": {
            "type": "string"
          },
          "data": {}
        },
        "required": [
          "defined",
          "code",
          "message"
        ]
      }
    }
  }
}
