{
  "name": "@trpc12/www",
  "version": "0.0.0",
  "private": true,
  "description": "Documentation site for tRPC v12, with its docs in www/docs",
  "type": "module",
  "exports": {
    "./site": "./src/site.ts"
  },
  "scripts": {
    "build": "vp build && node build/vercel-output.ts",
    "dev": "vp dev --port 3012",
    "start": "vp preview --port 3012",
    "smoke": "node smoke.ts",
    "typecheck": "tsc",
    "decisions:check": "node build/decisions-check.ts",
    "decisions:layout": "node decisions-layout.ts",
    "not-found:check": "node not-found-check.ts",
    "sentry:smoke": "node sentry-smoke.ts",
    "codemod-playground:check": "node codemod-playground-check.ts",
    "search:check": "node search-check.ts",
    "v12-reveal:check": "node v12-reveal-check.ts",
    "old-docs:copy": "node build/old-docs-copy.ts",
    "old-docs:check": "node build/old-docs-copy.ts --check",
    "sponsors:sync": "node build/sponsors-sync.ts",
    "sponsors:readme": "node build/sponsors-sync.ts --readme-only"
  },
  "dependencies": {
    "@codemirror/autocomplete": "6.20.3",
    "@codemirror/commands": "6.11.1",
    "@codemirror/lang-javascript": "6.2.5",
    "@codemirror/language": "6.13.1",
    "@codemirror/lint": "6.9.7",
    "@codemirror/state": "6.7.6",
    "@codemirror/view": "6.43.14",
    "@hookform/resolvers": "5.9.2",
    "@lezer/highlight": "1.2.5",
    "@oxc-parser/binding-wasm32-wasip1": "0.154.0",
    "@sentry/tanstackstart-react": "11.8.0",
    "@shared/ui": "workspace:*",
    "@tanstack/react-query": "5.104.1",
    "@tanstack/react-router": "1.170.42",
    "@tanstack/react-start": "1.168.61",
    "@trpc12/tanstack-react-query": "workspace:*",
    "@trpc12/trpc": "workspace:*",
    "@trpc12/upgrade": "workspace:*",
    "d3-hierarchy": "3.1.2",
    "lucide-react": "1.55.0",
    "minisearch": "7.2.0",
    "next-themes": "0.4.6",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-hook-form": "7.90.0",
    "sonner": "2.0.8",
