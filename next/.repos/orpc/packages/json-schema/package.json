{
  "name": "@orpc/json-schema",
  "type": "module",
  "version": "2.0.0-beta.44",
  "description": "JSON Schema conversion and smart request coercion for oRPC and OpenAPI",
  "license": "MIT",
  "funding": [
    "https://github.com/sponsors/dinwwwh",
    "https://opencollective.com/middleapi"
  ],
  "homepage": "https://orpc.dev",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/middleapi/orpc.git",
    "directory": "packages/json-schema"
  },
  "keywords": [
    "orpc",
    "json-schema",
    "openapi",
    "coercion",
    "validation",
    "typescript"
  ],
  "sideEffects": false,
  "publishConfig": {
    "exports": {
      "./package.json": "./package.json",
      ".": {
        "types": "./dist/index.d.mts",
        "import": "./dist/index.mjs",
        "default": "./dist/index.mjs"
      }
    }
  },
  "exports": {
    "./package.json": "./package.json",
    ".": "./src/index.ts"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "prepack": "unbuild",
    "type:check": "tsc -b"
  },
  "dependencies": {
    "@openapi-spec/types": "~0.3.0",
    "@orpc/client": "workspace:*",
    "@orpc/contract": "workspace:*",
    "@orpc/server": "workspace:*",
    "@orpc/shared": "workspace:*",
    "@standard-schema/spec": "^1.1.0"
  },
  "devDependencies": {
    "zod": "^4.6.5"
  }
}
