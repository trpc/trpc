---
// Sponsor wall, rendered at build time from sponsors/sponsors.ts (generated by
// scripts/sync-sponsors.ts, the same source the README tables come from).
import Icon from 'blume/components/Icon.astro'
import { relAttribute } from '../../sponsors/ads'
import { avatarSrc, pastSponsors, sponsorTiers } from '../../sponsors/data'

const tiers = sponsorTiers()

// The top tiers get a named card each, with rank marked by size: special
// sponsors take a full row each, while the tiers below share tier-weighted
// grid columns. Everything below joins the avatar wall, where a larger avatar
// still marks the higher tier. Specials span 0 columns because col-span-full
// takes them out of the shared-column math.
const highlightCard = (level: number) =>
  level >= 5
    ? { li: 'col-span-full', link: 'gap-4 p-4', avatar: 'size-14', avatarPx: 56, span: 0 }
    : level >= 4
      ? { li: 'lg:col-span-3', link: 'gap-4 p-4', avatar: 'size-12', avatarPx: 48, span: 3 }
      : { li: 'lg:col-span-2', link: 'gap-3 p-3', avatar: 'size-10', avatarPx: 40, span: 2 }

const highlights = tiers
  .filter(tier => tier.level >= 3)
  .flatMap(tier => tier.sponsors.map(sponsor => ({
    ...sponsor,
    // The narrow low-tier cards can't fit labels like "Organization Sponsor",
    // and every card here is a sponsor anyway.
    tier: tier.level >= 4 ? tier.title : tier.title.replace(/ sponsor$/i, ''),
    card: highlightCard(tier.level),
  })))

const wall = tiers.filter(tier => tier.level < 3).flatMap(tier => tier.sponsors)

// The shared row's column count is the sum of its members' spans, so the row
// always fills exactly as sponsors come and go. Capped to keep cards from
// getting too narrow once enough sponsors join (extras wrap), floored at 1 so
// `repeat()` stays valid when only specials exist.
const highlightCols = Math.min(Math.max(highlights.reduce((total, { card }) => total + card.span, 0), 1), 12)

const past = pastSponsors()
---

{
  tiers.length > 0 && (
    <section class="border-b border-border">
      <div class="mx-auto max-w-6xl px-6 py-20 sm:py-28">
        <div class="flex flex-col gap-6 sm:flex-row sm:items-end sm:justify-between">
          <div>
            <p class="font-mono text-[0.6875rem] tracking-[0.18em] text-muted-foreground uppercase">
              Sponsors
            </p>
            <h2 class="font-display mt-4 max-w-2xl text-3xl font-semibold tracking-[-0.03em] text-balance sm:text-4xl">
              Paid for by the people who build on it.
            </h2>
            <p class="mt-4 max-w-xl text-base leading-relaxed text-muted-foreground">
              oRPC is MIT licensed and developed in the open. Sponsorship is what buys the time
              that goes into it.
            </p>
          </div>
          <a class="orpc-btn orpc-btn-ghost shrink-0 self-start sm:self-auto" href="/sponsors">
            All sponsors
            <Icon name="arrow-right" size={15} />
          </a>
        </div>

        {highlights.length > 0 && (
          <ul
            class="mt-12 grid gap-3 sm:grid-cols-2 lg:grid-cols-[repeat(var(--highlight-cols),minmax(0,1fr))]"
            style={`--highlight-cols: ${highlightCols}`}
          >
            {highlights.map(sponsor => (
              <li class={sponsor.card.li}>
                <a
                  class:list={[
                    'flex h-full items-center rounded-blume border border-border transition-colors hover:bg-muted',
                    sponsor.card.link,
                  ]}
                  href={sponsor.link}
                  rel={relAttribute(sponsor.rel)}
                  target="_blank"
                >
                  <img
                    alt=""
                    class:list={['flex-none rounded-blume object-cover', sponsor.card.avatar]}
                    data-monogram={sponsor.name}
                    data-no-zoom
                    height={sponsor.card.avatarPx}
                    loading="lazy"
                    src={avatarSrc(sponsor.avatar, sponsor.card.avatarPx)}
                    width={sponsor.card.avatarPx}
                  />
                  <span class="min-w-0">
                    <span class="font-display block truncate text-sm font-semibold tracking-tight">
                      {sponsor.name}
                    </span>
                    <span class="mt-1 block truncate text-xs text-muted-foreground">
                      {sponsor.tier}
                    </span>
                  </span>
                </a>
              </li>
            ))}
          </ul>
        )}

        {wall.length > 0 && (
          <div class="mt-3 rounded-blume border border-border p-6">
            <p
              class="font-mono text-[0.6875rem] tracking-[0.18em] text-muted-foreground uppercase"
              id="sponsor-wall"
            >
              Sponsors and backers
            </p>
            <ul aria-labelledby="sponsor-wall" class="mt-5 flex flex-wrap items-center gap-2">
              {wall.map(sponsor => (
                <li>
                  {/* The name is the link's accessible name and its hover tooltip;
                      the avatar itself carries nothing extra to announce. */}
                  <a
                    aria-label={sponsor.name}
                    href={sponsor.link}
                    rel={relAttribute(sponsor.rel)}
                    target="_blank"
                    title={sponsor.name}
                  >
                    <img
                      alt=""
                      class:list={[
                        'rounded-full object-cover ring-1 ring-border transition hover:ring-foreground/40',
                        sponsor.tierLevel >= 2 ? 'size-12' : 'size-10',
                      ]}
                      data-monogram={sponsor.name}
                      data-no-zoom
                      height={sponsor.tierLevel >= 2 ? 48 : 40}
                      loading="lazy"
                      src={avatarSrc(sponsor.avatar, sponsor.tierLevel >= 2 ? 48 : 40)}
                      width={sponsor.tierLevel >= 2 ? 48 : 40}
                    />
                  </a>
                </li>
              ))}
            </ul>
          </div>
        )}

        {past.length > 0 && (
          <p class="mt-6 text-sm text-muted-foreground">
            With thanks to{' '}
            <a
              class="underline underline-offset-4 transition-colors hover:text-foreground"
              href="/sponsors#past-sponsors"
            >
              {past.length} past sponsors
            </a>{' '}
            who helped get oRPC here.
          </p>
        )}
      </div>
    </section>
  )
}

<script>
  import '../../sponsors/avatar-fallback'
</script>
