---
// Astro inlines the SVG and spreads our props onto its root <svg>, so the mark
// stays in sync with the file the header and favicon are generated from.
import Logo from '../../logo.svg'

interface FooterLink {
  label: string
  href: string
  /** Opens in a new tab. Defaults to true for off-site URLs. */
  external?: boolean
}

const columns: { title: string, links: FooterLink[] }[] = [
  {
    title: 'Documentation',
    links: [
      { label: 'Getting started', href: '/docs/getting-started' },
      { label: 'Contract-first', href: '/docs/contract-first' },
      { label: 'OpenAPI', href: '/docs/openapi/handler' },
      { label: 'Error handling', href: '/docs/error-handling' },
      { label: 'Migrate from tRPC', href: '/docs/migrations/from-trpc' },
      { label: 'Migrate from v1', href: '/docs/migrations/from-v1' },
    ],
  },
  {
    title: 'Ecosystem',
    links: [
      { label: 'TanStack Query', href: '/docs/integrations/tanstack-query' },
      { label: 'AI SDK', href: '/docs/integrations/ai-sdk' },
      { label: 'NestJS', href: '/docs/integrations/nest' },
      { label: 'Adapters', href: '/docs/adapters/fetch-api' },
      { label: 'Plugins', href: '/docs/plugins/cors' },
      { label: 'Community packages', href: '/docs/ecosystem' },
    ],
  },
  {
    title: 'Resources',
    links: [
      { label: 'Playgrounds', href: '/docs/playgrounds' },
      { label: 'Comparison', href: '/docs/comparison' },
      { label: 'Blog', href: '/blog' },
      { label: 'LLM context', href: '/llms.txt', external: true },
      { label: 'Releases', href: 'https://github.com/middleapi/orpc/releases' },
      { label: 'V1 documentation', href: 'https://v1.orpc.dev' },
    ],
  },
  {
    title: 'Community',
    links: [
      { label: 'GitHub', href: 'https://github.com/middleapi/orpc' },
      { label: 'Discussions', href: 'https://github.com/middleapi/orpc/discussions' },
      { label: 'Discord', href: 'https://discord.gg/TXEbwRBvQn' },
      { label: 'X', href: 'https://x.com/middleapi' },
      { label: 'Sponsors', href: '/sponsors' },
      { label: 'Experts', href: '/experts' },
    ],
  },
]

const FIRST_YEAR = 2024

const years = `${FIRST_YEAR}-${new Date().getFullYear()}`
---

<footer class="mx-auto max-w-6xl px-6 py-16">
  <div class="grid gap-10 sm:grid-cols-2 lg:grid-cols-[minmax(0,1fr)_repeat(4,auto)] lg:gap-16">
    <div>
      <a href="/" class="inline-flex items-center gap-2.5" aria-label="oRPC home">
        <Logo aria-hidden="true" class="size-5" />
        <span class="font-display text-base font-semibold tracking-tight">oRPC</span>
      </a>
      <p class="mt-4 max-w-xs text-sm leading-relaxed text-muted-foreground">
        Typesafe APIs made simple. Built and maintained in the open.
      </p>
    </div>

    {
      columns.map(column => (
        <div>
          <h2 class="text-[0.8125rem] font-semibold tracking-tight">{column.title}</h2>
          <ul class="mt-4 space-y-2.5">
            {
              column.links.map((link) => {
                const external = link.external ?? link.href.startsWith('http')

                return (
                  <li>
                    <a
                      class="text-sm text-muted-foreground transition-colors hover:text-foreground"
                      href={link.href}
                      rel={external ? 'noopener' : undefined}
                      target={external ? '_blank' : undefined}
                    >
                      {link.label}
                    </a>
                  </li>
                )
              })
            }
          </ul>
        </div>
      ))
    }
  </div>

  <div
    class="mt-14 flex flex-col gap-3 border-t border-border pt-6 text-sm text-muted-foreground sm:flex-row sm:items-center sm:justify-between"
  >
    <p>&copy; {years} oRPC contributors</p>
    <p>
      {/* The formatter breaks the line before the inline link and the compiler
          collapses that newline away, so the space is written explicitly. */}
      Released under the{' '}
      <a
        class="underline underline-offset-4 transition-colors hover:text-foreground"
        href="https://github.com/middleapi/orpc/blob/main/LICENSE"
        rel="noopener"
        target="_blank">MIT License</a
      >.
    </p>
  </div>
</footer>
