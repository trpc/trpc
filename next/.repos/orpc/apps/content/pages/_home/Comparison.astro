---
// A summary of /docs/comparison. Every cell and number here is lifted from that
// page, so the two must be edited together.
import Icon from 'blume/components/Icon.astro'

const columns = ['oRPC', 'tRPC', 'Hono']

// 'full' = first-class, built-in; 'partial' = needs a third-party package or
// only covers part of the case; 'none' = unsupported or undocumented.
const rows = [
  {
    feature: 'End-to-end typesafe errors',
    href: '/docs/client/error-handling',
    support: ['full', 'partial', 'full'],
  },
  {
    feature: 'End-to-end typesafe File and Blob',
    href: '/docs/binary-data',
    support: ['full', 'partial', 'partial'],
  },
  {
    // Merges the doc's two streaming rows: SSE (oRPC ✅, tRPC ✅, Hono 🛑) and
    // ReadableStream (oRPC ✅, tRPC 🛑, Hono 🛑). tRPC covers one of the two.
    feature: 'End-to-end typesafe streaming',
    href: '/docs/async-iterator-object',
    support: ['full', 'partial', 'none'],
  },
  {
    feature: 'Contract-first approach',
    href: '/docs/contract/procedure',
    support: ['full', 'none', 'full'],
  },
  {
    feature: 'OpenAPI spec generation',
    href: '/docs/openapi/specification',
    support: ['full', 'partial', 'full'],
  },
  {
    // @orpc/tanstack-query returns options objects, not hooks, so it works with
    // every TanStack Query adapter: React, Vue, Solid, Svelte, and Angular.
    // tRPC's integration is React-only; Hono leaves you to wire its client up.
    feature: 'TanStack Query for every framework',
    href: '/docs/integrations/tanstack-query',
    support: ['full', 'partial', 'none'],
  },
]

const legend = {
  full: { symbol: '✅', label: 'first-class support' },
  partial: { symbol: '🟡', label: 'partial or third-party support' },
  none: { symbol: '🛑', label: 'not supported' },
}

// The same key the comparison page prints above its tables, so the markers mean
// something to sighted readers too.
const legendOrder = ['full', 'partial', 'none'] as const

const numbers = [
  {
    value: '4.2x',
    body: 'the RPC throughput of tRPC over HTTP, and 4.4x over WebSocket.',
  },
  {
    value: '30%',
    body: 'faster type-checking than tRPC across 3,000 procedures, on 31% less memory.',
  },
  {
    value: '14.5 kB',
    body: 'gzipped for a client and server pair, against 23.7 kB for tRPC.',
  },
]
---

<section class="border-b border-border">
  <div class="mx-auto max-w-6xl px-6 py-20 sm:py-28">
    <div class="flex flex-col gap-6 sm:flex-row sm:items-end sm:justify-between">
      <div>
        <p class="font-mono text-[0.6875rem] tracking-[0.18em] text-muted-foreground uppercase">
          Comparison
        </p>
        <h2 class="font-display mt-4 max-w-2xl text-3xl font-semibold tracking-[-0.03em] text-balance sm:text-4xl">
          Measured against the alternatives.
        </h2>
        <p class="mt-4 max-w-xl text-base leading-relaxed text-muted-foreground">
          oRPC, tRPC, and Hono all deliver typesafe APIs. Here is where they part ways, with the
          full feature matrix and reproducible benchmarks on the comparison page.
        </p>
      </div>
      <a class="orpc-btn orpc-btn-ghost shrink-0 self-start sm:self-auto" href="/docs/comparison">
        Full comparison
        <Icon name="arrow-right" size={15} />
      </a>
    </div>

    {/* tabindex makes the scroller reachable by keyboard, which is the only way
        to read the tRPC and Hono columns on a narrow screen without a mouse. */}
    <div
      aria-label="Feature comparison"
      class="orpc-scroller mt-12 overflow-x-auto rounded-blume border border-border"
      role="region"
      tabindex="0"
    >
      <table class="orpc-compare">
        <thead>
          <tr>
            <th scope="col">Feature</th>
            {columns.map(column => <th scope="col">{column}</th>)}
          </tr>
        </thead>
        <tbody>
          {
            rows.map(row => (
              <tr>
                <th scope="row">
                  <a href={row.href}>{row.feature}</a>
                </th>
                {row.support.map(level => (
                  <td>
                    <span aria-hidden="true">{legend[level].symbol}</span>
                    <span class="sr-only">{legend[level].label}</span>
                  </td>
                ))}
              </tr>
            ))
          }
        </tbody>
      </table>
    </div>

    <ul class="mt-4 flex flex-wrap gap-x-5 gap-y-2 text-xs text-muted-foreground">
      {
        legendOrder.map(level => (
          <li class="flex items-center gap-1.5">
            <span aria-hidden="true">{legend[level].symbol}</span>
            {legend[level].label}
          </li>
        ))
      }
    </ul>

    <ul class="mt-10 grid gap-3 sm:grid-cols-3">
      {
        numbers.map(number => (
          <li class="rounded-blume border border-border p-5">
            <p class="font-display text-2xl font-semibold tracking-[-0.03em] tabular-nums">
              {number.value}
            </p>
            <p class="mt-1.5 text-sm leading-relaxed text-muted-foreground">{number.body}</p>
          </li>
        ))
      }
    </ul>

    <p class="mt-4 text-xs text-muted-foreground">
      All three are fast enough for production. The{' '}
      <a
        class="underline underline-offset-4 transition-colors hover:text-foreground"
        href="/docs/comparison#performance">comparison page</a
      > has the versions, the method, and every number these are drawn from.
    </p>
  </div>
</section>
