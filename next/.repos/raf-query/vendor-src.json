{
	"$schema": "https://unpkg.com/vendor-src/schema.json",
	"dir": ".repos",
	"rootAgentsMd": true,
	"repos": {
		"query": {
			"packages": ["@tanstack/react-query"],
			"url": "https://github.com/TanStack/query.git",
			"version": "5.104.1",
			"ref": "@tanstack/react-query@5.104.1"
		},
		"router": {
			"packages": ["@tanstack/react-router"],
			"url": "https://github.com/TanStack/router.git",
			"version": "1.170.42",
			"ref": "@tanstack/react-router@1.170.42"
		},
		"effect": {
			"packages": ["effect"],
			"url": "https://github.com/Effect-TS/effect.git",
			"version": "4.0.1",
			"ref": "effect@4.0.1",
			"ignore": [
				"scratchpad/**",
				"**/.github/**",
				"**/.vscode/**",
				"**/.changeset/**",
				"**/pnpm-lock.yaml"
			]
		}
	}
}
