				"eqeqeq": "off",
				"react/button-has-type": "off",
				"@typescript-eslint/array-type": "off",
				"curly": "off",
				"import-x/no-namespace": "off",
				"object-shorthand": "off",
				"perfectionist/sort-enums": "off",
