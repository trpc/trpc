{
	"editor.defaultFormatter": "oxc.oxc-vscode",
	"[javascript]": {
		"editor.defaultFormatter": "oxc.oxc-vscode"
	},
	"[javascriptreact]": {
		"editor.defaultFormatter": "oxc.oxc-vscode"
	},
	"[typescript]": {
		"editor.defaultFormatter": "oxc.oxc-vscode"
	},
	"[typescriptreact]": {
		"editor.defaultFormatter": "oxc.oxc-vscode"
	},
	"[json]": {
		"editor.defaultFormatter": "oxc.oxc-vscode"
	},
	"[jsonc]": {
		"editor.defaultFormatter": "oxc.oxc-vscode"
	},
	"[markdown]": {
		"editor.defaultFormatter": "oxc.oxc-vscode",
		"editor.formatOnSave": true
	},
	"markdownlint.enable": false,
	"json.schemaDownload.enable": true,
	"oxc.path.oxfmt": "./node_modules/oxfmt/bin/oxfmt",
	"oxc.path.oxlint": "./node_modules/oxlint/bin/oxlint",
	"oxc.fmt.configPath": "./.oxfmtrc.json",
	"oxc.configPath": "./.oxlintrc.json",
	"oxc.disableNestedConfig": true,
	"oxc.fmt.disableNestedConfig": true,
	"editor.formatOnSave": true,
	"editor.formatOnSaveMode": "file",
	"editor.codeActionsOnSave": {
		"source.fixAll.oxc": "explicit"
	},
	"editor.stickyScroll.enabled": true,
	"typescript.tsdk": "node_modules/typescript/lib",
	"typescript.enablePromptUseWorkspaceTsdk": true,
	"typescript.preferences.autoImportFileExcludePatterns": [".repos/**"],
	"javascript.preferences.autoImportFileExcludePatterns": [".repos/**"],
	"files.exclude": {
		"**/.repos": true
	},
	"files.watcherExclude": {
		"**/.repos/**": true
	},
	"search.exclude": {
		"**/.repos": true,
		"**/dist": true,
		"**/coverage": true
	},
	"workbench.colorCustomizations": {
		"titleBar.activeBackground": "#0f766e",
		"titleBar.activeForeground": "#ffffff",
		"titleBar.inactiveBackground": "#115e59",
		"titleBar.inactiveForeground": "#99f6e4"
	}
}
