{
  "name": "tanstack-vue-start-e2e-basic-cloudflare",
  "private": true,
  "sideEffects": false,
  "type": "module",
  "scripts": {
    "dev": "vite dev --port 3000",
    "dev:e2e": "vite dev",
    "build": "vite build && tsc --noEmit",
    "preview": "vite preview",
    "cf-typegen": "wrangler types",
    "postinstall": "WRANGLER_LOG=warn npm run --silent cf-typegen",
    "test:e2e": "playwright test --project=chromium"
  },
  "dependencies": {
    "@tanstack/vue-router": "workspace:^",
    "@tanstack/vue-router-devtools": "workspace:^",
    "@tanstack/vue-start": "workspace:^",
    "vue": "^3.5.25"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "^1.29.0",
    "@playwright/test": "^1.61.0",
    "@tailwindcss/vite": "^4.2.2",
    "@tanstack/router-e2e-utils": "workspace:^",
    "@types/node": "^22.10.2",
    "tailwindcss": "^4.2.2",
    "@typescript/native": "npm:typescript@^7.0.2",
    "typescript": "npm:@typescript/typescript6@^6.0.2",
    "vite": "^8.0.14",
    "@vitejs/plugin-vue": "^6.0.5",
    "@vitejs/plugin-vue-jsx": "^5.1.5",
    "wrangler": "^4.74.0"
  },
  "nx": {
    "targets": {
      "test:e2e": {
        "outputs": [
          "...",
          "{projectRoot}/.wrangler/deploy"
        ]
      }
    }
  }
}
