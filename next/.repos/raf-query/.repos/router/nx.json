{
  "$schema": "./node_modules/nx/schemas/nx-schema.json",
  "defaultBase": "main",
  "nxCloudId": "6442f7de8226a6291646a813",
  "useInferencePlugins": false,
  "parallel": 5,
  "tui": {
    "enabled": false
  },
  "namedInputs": {
    "sharedGlobals": [
      "{workspaceRoot}/.npmrc",
      "{workspaceRoot}/.nx/workflows/sandboxing-config.yaml",
      "{workspaceRoot}/.nvmrc",
      "{workspaceRoot}/package.json",
      "{workspaceRoot}/tsconfig.json"
    ],
    "dependentTaskOutputs": [
      {
        "dependentTasksOutputFiles": "**/*",
        "transitive": true
      }
    ],
    "streamingSsrTests": [
      "{workspaceRoot}/e2e/streaming-ssr-assertions.ts",
      "{workspaceRoot}/e2e/streaming-ssr-fixtures/**/*",
      "{workspaceRoot}/e2e/streaming-ssr-specs/**/*"
    ],
    "default": [
      "sharedGlobals",
      "{projectRoot}/**/*",
      "!{projectRoot}/**/*.md"
    ],
    "production": [
      "default",
      "!{projectRoot}/tests/**/*",
      "!{projectRoot}/eslint.config.js"
    ],
    "buildProduction": ["sharedGlobals", "{projectRoot}/**/*"]
  },
  "targetDefaults": {
    "test:docs": {
      "cache": true,
      "inputs": ["{workspaceRoot}/docs/**/*"]
    },
    "test:eslint": {
      "cache": true,
      "dependsOn": ["^build", "build"],
      "inputs": [
        "default",
        "^production",
        "{workspaceRoot}/eslint.config.js",
        "dependentTaskOutputs"
      ]
    },
    "test:unit": {
      "cache": true,
      "dependsOn": ["^build"],
      "inputs": [
        "default",
        "^production",
        "{workspaceRoot}/eslint.config.js",
        "dependentTaskOutputs"
      ],
      "outputs": ["{projectRoot}/coverage"]
    },
    "test:e2e": {
      "cache": true,
      "dependsOn": ["^build", "test:e2e--*"],
      "inputs": ["buildProduction", "^production", "dependentTaskOutputs"],
      "outputs": ["{projectRoot}/dist", "{projectRoot}/test-results"],
      "parallelism": false
    },
    "test:e2e:nitro": {
      "cache": true,
      "dependsOn": ["^build"],
      "inputs": ["default", "^production"],
      "parallelism": false
    },
    "test:e2e:basepath": {
      "cache": true,
      "dependsOn": ["^build"],
      "inputs": ["default", "^production"],
      "parallelism": false
    },
    "test:e2e:preview": {
      "cache": true,
      "dependsOn": ["^build"],
      "inputs": ["default", "^production"],
      "parallelism": false
    },
    "test:types": {
      "cache": true,
      "dependsOn": ["^build", "build"],
      "inputs": [
        "default",
        "^production",
        "{workspaceRoot}/eslint.config.js",
        "dependentTaskOutputs"
      ]
    },
    "test:types:client": {
      "cache": true,
      "inputs": [
        "default",
        "^production",
        "{workspaceRoot}/benchmarks/client-nav/*.{ts,json}",
        "{workspaceRoot}/benchmarks/client-nav/scenarios/*.ts",
        "{workspaceRoot}/benchmarks/client-nav/scenarios/*/*.ts",
        "{workspaceRoot}/benchmarks/memory/*.ts",
        "{workspaceRoot}/benchmarks/memory/client/*.{ts,json}",
        "{workspaceRoot}/benchmarks/memory/client/scenarios/*/*.ts",
        "{workspaceRoot}/benchmarks/cpu-simulation.ts",
        "dependentTaskOutputs"
      ]
    },
    "test:types:ssr": {
      "cache": true,
      "dependsOn": ["^build", "build"],
      "inputs": [
        "default",
        "^production",
        "{workspaceRoot}/benchmarks/ssr/bench-utils.ts",
        "{workspaceRoot}/benchmarks/cpu-simulation.ts",
        "{workspaceRoot}/benchmarks/ssr/scenarios/*/*.ts",
        "{workspaceRoot}/benchmarks/memory/*.ts",
        "{workspaceRoot}/benchmarks/memory/server/*.ts",
        "{workspaceRoot}/benchmarks/memory/server/scenarios/*/*.ts",
        "dependentTaskOutputs"
      ]
    },
    "build": {
      "cache": true,
      "dependsOn": ["^build"],
      "inputs": ["buildProduction", "^buildProduction", "dependentTaskOutputs"],
      "outputs": [
        "{projectRoot}/.netlify",
        "{projectRoot}/.wrangler",
        "{projectRoot}/.output",
        "{projectRoot}/build",
        "{projectRoot}/dist"
      ]
    },
    "test:build": {
      "cache": true,
      "dependsOn": ["build"],
      "inputs": ["buildProduction", "dependentTaskOutputs"]
    },
    "test:e2e*": {
      "parallelism": false
    }
  },
  "plugins": [
    {
      "name": "Playwright Sharding Plugin",
      "plugin": "./scripts/nx/playwright-plugin.ts"
    }
  ],
  "analytics": true
}
