{
	"compilerOptions": {
		"jsx": "react-jsx",
		"lib": ["ES2024", "DOM", "DOM.Iterable"],
		"module": "preserve",
		"moduleResolution": "bundler",
		"allowImportingTsExtensions": true,
		"noEmit": true,
		"paths": {
			"@examples/kit/*": ["./src/*"]
		},
		"skipLibCheck": true,
		"strict": true,
		"target": "ES2024"
	},
	"include": ["src"]
}
