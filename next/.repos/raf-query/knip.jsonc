{
	"$schema": "https://unpkg.com/knip@6/schema-jsonc.json",
	// Every issue type fails the run. `nsExports` and `nsTypes` are off by
	// default; `cycles` is a warning by default. `pnpm knip` does not pass
	// `--strict`: that flag is production mode, which skips tests and
	// devDependencies, so it would miss unused code this run reports.
	"rules": {
		"files": "error",
		"dependencies": "error",
		"devDependencies": "error",
		"optionalPeerDependencies": "error",
		"unlisted": "error",
		"binaries": "error",
		"unresolved": "error",
		"exports": "error",
		"nsExports": "error",
		"types": "error",
		"nsTypes": "error",
		"duplicates": "error",
		"enumMembers": "error",
		"namespaceMembers": "error",
		"catalog": "error",
		"catalogReferences": "error",
		"cycles": "error",
	},
	// An export used only in its own file does not need the `export` keyword.
	"ignoreExportsUsedInFile": false,
	// Private workspaces have no consumers outside this repo, so an export on
	// an entry file that nothing imports is unused. Packages that publish a
	// surface (and the shadcn kit) turn this off below.
	"includeEntryExports": true,
	"treatConfigHintsAsErrors": true,
	"treatTagHintsAsErrors": true,
	// Report a binary Knip does not already treat as a shell built-in. The
	// list below is the built-ins this repo's scripts actually call.
	"ignoreGlobalBinaries": false,
	"ignoreBinaries": ["echo", "exit", "git", "node", "rm"],
	// `import()` still counts. A deferred import does not make a cycle safe.
	"cycles": {
		"dynamicImports": true,
	},
	// Vendored dependency checkouts. Not part of this repo's graph.
	"ignore": [".repos/**"],
	"workspaces": {
		".": {
			// Skill helpers are run with `node` by agents following the skill.
			"entry": ["scripts/**/*.ts", ".agents/skills/*/scripts/**/*.mjs"],
			"ignoreDependencies": [
				// `vp lint` / `vp fmt` load these. vite-plus depends on them
				// too; the root pins the versions those commands run.
				"oxfmt",
				"oxlint",
				"oxlint-tsgolint",
				// CI runs `pnpm test --coverage`. Each package's vite config
				// names the provider; this copy is the one the root command
				// resolves.
				"@vitest/coverage-v8",
			],
		},
		"packages/core": {
			// `src/index.ts` is the published API.
			"includeEntryExports": false,
		},
		"packages/react": {
			"includeEntryExports": false,
		},
		".experimental/vue/package": {
			"includeEntryExports": false,
		},
		".experimental/svelte/package": {
			"includeEntryExports": false,
		},
		".experimental/tanstack-query/package": {
			// Same surface as `@raf-query/react`, kept for the comparison even
			// where the experimental apps don't call every export.
			"includeEntryExports": false,
		},
		"examples/.shared/ui": {
			// `package.json` exports are the shadcn kit. Components are added
			// with the CLI and stay available to the apps.
			"includeEntryExports": false,
		},
		"examples/.shared/api": {
			// `@examples/api/client` imports bind to the `default` condition.
			// `browser.ts` is the same surface for the browser build.
			"ignoreIssues": {
				"src/browser.ts": ["exports", "types"],
			},
		},
		"examples/nextjs": {
			// The Tailwind plugin resolves this from the app root while
			// compiling `@import "tailwindcss"` in `@examples/ui`.
			"ignoreDependencies": ["tailwindcss"],
			// `#forwarded-headers` imports bind to the `default` file.
			// `forwarded-headers.server.ts` is the same surface for the
			// `react-server` build.
			"ignoreIssues": {
				"src/forwarded-headers.server.ts": ["exports", "types"],
			},
		},
		"examples/tanstack-start": {
			"ignoreDependencies": ["tailwindcss"],
		},
		"examples/tanstack-start-effect": {
			"ignoreDependencies": ["tailwindcss"],
			// `#rpc-transport` imports bind to the server file.
			"ignoreIssues": {
				"src/rpc-transport.browser.ts": ["exports", "types"],
			},
		},
		".experimental/tanstack-query/nextjs": {
			"ignoreDependencies": ["tailwindcss"],
		},
		".experimental/tanstack-query/start": {
			"ignoreDependencies": ["tailwindcss"],
		},
		"examples/react-router": {
			// Tailwind resolves from the app root while compiling
			// `@import "tailwindcss"` in `@examples/ui`.
			"ignoreDependencies": ["tailwindcss"],
			// `./+types/*` is generated by `react-router typegen` into
			// `.react-router/types` (tsconfig `rootDirs`); Knip does not.
			"ignoreIssues": {
				"app/{root,routes/**/*}.{ts,tsx}": ["unresolved"],
			},
		},
		"tooling/bundle-size": {
			// Fixtures are bundled by path from `measure.ts`. `analyze.ts` is
			// a CLI. Their exports are the measured surface.
			"entry": ["src/analyze.ts", "fixtures/**/*.{ts,tsx}"],
			"includeEntryExports": false,
		},
		"tooling/rsc-frameworks": {
			// Each app is built by path from its test, with its own vite config.
			"entry": ["vite-rsc/vite.config.ts", "vite-rsc/entry.*.tsx"],
			"includeEntryExports": false,
		},
		"tooling/oxlint-plugins": {
			// Loaded by path from the root `.oxlintrc.json`.
			"entry": [
				"anti-slop/index.ts",
				"anti-slop/effect/index.ts",
				"nkzw/index.ts",
				"workspace.ts",
			],
			"includeEntryExports": false,
		},
		"www": {
			// The build reads the sample apps from disk and Twoslash resolves
			// their imports from each app's `node_modules`, so www installs
			// them. `sample:…` imports are a virtual module of
			// `build/content.ts`.
			"ignoreDependencies": [
				"@samples/nextjs",
				"@samples/react-router",
				"@samples/react-router-spa",
				"@samples/tanstack-start",
				"@samples/tanstack-start-effect",
				"sample",
			],
		},
		"www/samples/*": {
			// The docs show these files through `sample` fences in markdown,
			// which Knip does not parse: every file is an entry, and its
			// exports are what the pages import.
			"entry": ["src/**/*.{ts,tsx}"],
			"includeEntryExports": false,
		},
		".experimental/svelte/sample": {
			"entry": ["src/**/*.{ts,svelte}"],
			"includeEntryExports": false,
		},
		".experimental/vue/sample": {
			"entry": ["src/**/*.{ts,vue}"],
			"includeEntryExports": false,
		},
		"www/samples/react-router": {
			"entry": ["app/**/*.{ts,tsx}"],
			"includeEntryExports": false,
			"ignoreIssues": {
				// `./+types/*` is generated by `react-router typegen` into
				// `.react-router/types` (tsconfig `rootDirs`); Knip does not.
				"app/{root,routes/*}.tsx": ["unresolved"],
				// The app is only type-checked, never built, so it doesn't
				// install what React Router's default server entry imports.
				"react-router.config.ts": ["unlisted"],
			},
		},
		"www/samples/react-router-spa": {
			"entry": ["app/**/*.{ts,tsx}"],
			"includeEntryExports": false,
			"ignoreIssues": {
				"app/routes/*.tsx": ["unresolved"],
				"react-router.config.ts": ["unlisted"],
			},
		},
	},
}
