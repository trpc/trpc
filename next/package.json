{
  "name": "trpc-next",
  "private": true,
  "type": "module",
  "scripts": {
    "prepare": "vp config --no-agent --hooks-dir .vite-hooks",
    "typecheck": "pnpm -r run typecheck",
    "check": "vp check",
    "fix": "vp check --fix",
    "fmt": "vp fmt",
    "lint": "vp lint",
    "test": "vp test run",
    "coverage": "vp test run --coverage",
    "test:watch": "vp test watch",
    "test:bun": "pnpm --filter @trpc12/trpc run test:bun",
    "example": "pnpm -r --workspace-concurrency=1 --filter './examples/*' run smoke",
    "decisions": "node tooling/decisions/decisions.ts",
    "build": "pnpm -r run build",
    "bench": "pnpm --filter @tooling/bench run bench",
    "postinstall": "vendor-src check",
    "vendor:sync": "vendor-src sync"
  },
  "dependencies": {
    "@sveltejs/vite-plugin-svelte": "7.3.1",
    "svelte": "5.57.2",
    "typescript": "^7.0.2",
    "vendor-src": "0.15.4",
    "vite-plus": "1.1.0"
  },
  "devDependencies": {
    "@vitest/coverage-v8": "5.0.3"
  },
  "engines": {
    "node": "^24.11.0",
    "pnpm": "^12.0.0"
  },
  "packageManager": "pnpm@12.4.1"
}
