{
  "name": "trpc-next",
  "private": true,
  "type": "module",
  "scripts": {
    "prepare": "vp config --no-agent --hooks-dir .vite-hooks",
    "typecheck": "pnpm -r run typecheck",
    "check": "vp check && pnpm lint:docs",
    "fix": "vp check --fix",
    "fmt": "vp fmt",
    "lint": "vp lint && pnpm lint:docs",
    "lint:docs": "node tooling/docs-lint/docs-lint.ts",
    "test": "node tooling/dev/src/bin/vp.ts test run",
    "coverage": "node tooling/dev/src/bin/vp.ts test run --coverage --project 'packages*'",
    "test:watch": "node tooling/dev/src/bin/vp.ts test watch",
    "test:bun": "pnpm --filter @trpc12/trpc run test:bun",
    "example": "pnpm -r --workspace-concurrency=1 --filter './examples/*' --filter './examples/experimental/*' run smoke",
    "decisions": "node tooling/decisions/decisions.ts",
    "build": "pnpm -r run build",
    "docs:dev": "pnpm --filter @trpc12/www dev",
    "docs:build": "pnpm --filter @trpc12/www build",
    "bench": "pnpm --filter @tooling/bench run bench",
    "postinstall": "vendor-src check",
    "vendor:sync": "vendor-src sync",
    "land": "node tooling/dev/src/bin/land.ts",
    "ci:wait": "node tooling/dev/src/bin/ci-wait.ts"
  },
  "dependencies": {
    "@sveltejs/vite-plugin-svelte": "7.3.1",
    "svelte": "5.57.2",
    "typescript": "^7.0.2",
    "vendor-src": "0.16.0",
    "vite-plus": "1.1.0"
  },
  "devDependencies": {
    "@changesets/cli": "3.0.3",
    "@vitest/coverage-v8": "5.0.3"
  },
  "engines": {
    "node": "^24.11.0",
    "pnpm": "^12.0.0"
  },
  "packageManager": "pnpm@12.4.1"
}
