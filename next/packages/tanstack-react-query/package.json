{
  "name": "@trpc12/tanstack-react-query",
  "version": "0.1.0",
  "private": true,
  "files": [
    "dist"
  ],
  "type": "module",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "default": "./src/index.ts"
    },
    "./rsc": {
      "types": "./src/rsc.ts",
      "default": "./src/rsc.ts"
    }
  },
  "publishConfig": {
    "exports": {
      ".": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "./rsc": {
        "types": "./dist/rsc.d.ts",
        "default": "./dist/rsc.js"
      }
    },
    "access": "public"
  },
  "scripts": {
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "build": "node ../../tooling/pack/pack.ts"
  },
  "dependencies": {
    "@trpc12/tanstack-query": "workspace:*"
  },
  "devDependencies": {
    "@tanstack/query-core": "5.104.1",
    "@tanstack/react-query": "5.104.1",
    "@trpc12/trpc": "workspace:*",
    "@types/react": "19.3.0",
    "react": "19.3.0",
    "typescript": "^7.0.2"
  },
  "peerDependencies": {
    "@tanstack/react-query": "^5.104.0",
    "@trpc12/trpc": "workspace:*",
    "react": "^19"
  }
}
