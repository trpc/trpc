{
  "name": "@trpc12/tanstack-react-query",
  "version": "0.1.0",
  "private": true,
  "description": "tRPC for TanStack React Query: a context for the client and its helpers, useSubscription, and server-component helpers in /rsc.",
  "files": [
    "dist"
  ],
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "default": "./src/index.ts"
    },
    "./rsc": {
      "types": "./src/rsc.ts",
      "default": "./src/rsc.ts"
    }
  },
  "publishConfig": {
    "exports": {
      ".": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "./rsc": {
        "types": "./dist/rsc.d.ts",
        "default": "./dist/rsc.js"
      }
    },
    "access": "public"
  },
  "scripts": {
    "typecheck": "tsc --noEmit -p tsconfig.lib.json && tsc --noEmit -p tsconfig.json",
    "build": "node ../../tooling/pack/pack.ts"
  },
  "dependencies": {
    "@trpc12/tanstack-query": "workspace:*"
  },
  "devDependencies": {
    "@tanstack/query-core": "5.104.1",
    "@tanstack/react-query": "5.104.1",
    "@tooling/tsconfig": "workspace:*",
    "@trpc12/trpc": "workspace:*",
    "@types/node": "^26.0.0",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "effect": "4.1.1",
    "happy-dom": "20.14.6",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "typescript": "7.1.0-beta",
    "vite-plus": "1.1.0"
  },
  "peerDependencies": {
    "@tanstack/react-query": "^5.104.0",
    "@trpc12/trpc": "workspace:*",
    "effect": "^4.1.0",
    "react": "^19"
  }
}
