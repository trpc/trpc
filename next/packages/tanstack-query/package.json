{
  "name": "@trpc12/tanstack-query",
  "version": "0.1.0",
  "private": true,
  "description": "TanStack Query options, keys and filters for tRPC procedures, for every TanStack Query framework.",
  "files": [
    "dist"
  ],
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "default": "./src/index.ts"
    }
  },
  "publishConfig": {
    "exports": {
      ".": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      }
    },
    "access": "public"
  },
  "scripts": {
    "typecheck": "tsc --noEmit -p tsconfig.lib.json && tsc --noEmit -p tsconfig.json",
    "build": "node ../../tooling/pack/pack.ts"
  },
  "devDependencies": {
    "@effect/platform-node": "4.1.1",
    "@tanstack/db": "0.15.0",
    "@tanstack/query-core": "5.104.1",
    "@tanstack/query-db-collection": "1.4.5",
    "@tooling/tsconfig": "workspace:*",
    "@trpc12/trpc": "workspace:*",
    "@types/node": "^26.0.0",
    "effect": "4.1.1",
    "superjson": "2.2.6",
    "typescript": "7.1.0-beta",
    "vite-plus": "1.1.0",
    "zod": "4.6.5"
  },
  "peerDependencies": {
    "@tanstack/query-core": "^5.104.0",
    "@trpc12/trpc": "workspace:*",
    "effect": "^4.1.0"
  },
  "peerDependenciesMeta": {
    "@tanstack/query-core": {
      "optional": true
    }
  }
}
