{
  "name": "@trpc12/experimental-nest",
  "version": "0.1.0",
  "private": true,
  "description": "Serve a tRPC contract from NestJS controllers, with injected services reaching the resolvers.",
  "files": [
    "dist"
  ],
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "default": "./src/index.ts"
    }
  },
  "publishConfig": {
    "exports": {
      ".": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      }
    },
    "access": "public"
  },
  "scripts": {
    "typecheck": "tsc --noEmit -p tsconfig.lib.json && tsc --noEmit -p tsconfig.json",
    "build": "node ../../tooling/pack/pack.ts"
  },
  "devDependencies": {
    "@effect/platform-node": "^4.1.1",
    "@nestjs/common": "^12.1.3",
    "@nestjs/core": "^12.1.3",
    "@nestjs/platform-express": "12.1.3",
    "@tooling/tsconfig": "workspace:*",
    "@trpc12/trpc": "workspace:*",
    "@types/node": "^26.0.0",
    "effect": "^4.1.1",
    "reflect-metadata": "0.2.2",
    "rxjs": "^7.8.2",
    "typescript": "7.1.0-beta",
    "vite-plus": "1.1.0"
  },
  "peerDependencies": {
    "@effect/platform-node": "^4.1.0",
    "@nestjs/common": "^12.0.0",
    "@nestjs/core": "^12.0.0",
    "@trpc12/trpc": "workspace:*",
    "effect": "^4.1.0",
    "rxjs": "^7.8.0"
  }
}
