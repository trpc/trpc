{
  "name": "@trpc12/experimental-react-atom",
  "version": "0.1.0",
  "private": true,
  "description": "Experimental: tRPC queries, mutations and subscriptions as Effect atoms, typed with each procedure's errors.",
  "files": [
    "dist"
  ],
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "default": "./src/index.ts"
    }
  },
  "publishConfig": {
    "exports": {
      ".": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      }
    },
    "access": "public"
  },
  "scripts": {
    "typecheck": "tsc --noEmit -p tsconfig.lib.json && tsc --noEmit -p tsconfig.json",
    "build": "node ../../tooling/pack/pack.ts"
  },
  "devDependencies": {
    "@effect/atom-react": "4.1.1",
    "@tooling/tsconfig": "workspace:*",
    "@trpc12/trpc": "workspace:*",
    "@types/node": "^26.0.0",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "effect": "4.1.1",
    "happy-dom": "20.14.6",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "typescript": "7.1.0-beta",
    "vite-plus": "1.1.0"
  },
  "peerDependencies": {
    "@trpc12/trpc": "workspace:*",
    "effect": "^4.0.0"
  }
}
