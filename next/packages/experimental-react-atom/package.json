    "build": "node ../../tooling/pack/pack.ts"
  },
  "devDependencies": {
    "@trpc12/trpc": "workspace:*",
    "effect": "4.0.2",
    "typescript": "^7.0.2"
  },
  "peerDependencies": {
    "@trpc12/trpc": "workspace:*",
    "effect": "^4.0.0"
  }
}
