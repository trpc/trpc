{
  "name": "@trpc12/upgrade",
  "version": "0.1.0",
  "private": true,
  "description": "The codemod from tRPC v11 to v12: rewrites imports, names, links and transformers, and lists what is left.",
  "bin": {
    "trpc12-upgrade": "./dist/bin.js"
  },
  "files": [
    "dist"
  ],
  "type": "module",
  "sideEffects": [
    "./src/bin.ts",
    "./dist/bin.js"
  ],
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "default": "./src/index.ts"
    }
  },
  "publishConfig": {
    "exports": {
      ".": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      }
    },
    "access": "public"
  },
  "scripts": {
    "typecheck": "tsc --noEmit -p tsconfig.lib.json && tsc --noEmit -p tsconfig.json",
    "build": "node ../../tooling/pack/pack.ts src/bin.ts"
  },
  "dependencies": {
    "@effect/platform-node": "^4.1.0",
    "effect": "^4.1.0",
    "magic-string": "^0.30.21",
    "oxc-parser": "^0.154.0"
  },
  "devDependencies": {
    "@tooling/tsconfig": "workspace:*",
    "@types/node": "^26.0.0",
    "typescript": "7.1.0-beta",
    "vite-plus": "1.1.0"
  }
}
