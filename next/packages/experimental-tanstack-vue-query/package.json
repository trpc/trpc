{
  "name": "@trpc12/experimental-tanstack-vue-query",
  "version": "0.1.0",
  "private": true,
  "description": "tRPC for TanStack Vue Query: an app plugin (or provideTrpc()) for the client and its helpers, and useSubscription.",
  "files": [
    "dist"
  ],
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "default": "./src/index.ts"
    }
  },
  "publishConfig": {
    "exports": {
      ".": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      }
    },
    "access": "public"
  },
  "scripts": {
    "typecheck": "tsc --noEmit -p tsconfig.lib.json && tsc --noEmit -p tsconfig.json",
    "build": "node ../../tooling/pack/pack.ts"
  },
  "dependencies": {
    "@trpc12/tanstack-query": "workspace:*"
  },
  "devDependencies": {
    "@tanstack/query-core": "5.104.1",
    "@tanstack/vue-query": "5.104.1",
    "@tooling/tsconfig": "workspace:*",
    "@trpc12/trpc": "workspace:*",
    "@types/node": "^26.0.0",
    "effect": "4.1.1",
    "happy-dom": "20.14.6",
    "typescript": "7.1.0-beta",
    "vite-plus": "1.1.0",
    "vue": "3.5.43"
  },
  "peerDependencies": {
    "@tanstack/vue-query": "^5.104.0",
    "@trpc12/trpc": "workspace:*",
    "effect": "^4.1.0",
    "vue": "^3.5"
  }
}
