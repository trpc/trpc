{
  "name": "examples-next-prisma-websockets-starter",
  "private": true,
  "engines": {
    "node": ">=20"
  },
  "packageManager": "pnpm@10.33.1",
  "scripts": {
    "prebuild": "prisma generate && prisma migrate deploy",
    "build:1-next": "cross-env NODE_ENV=production next build",
    "build:2-server": "tsc --project tsconfig.server.json",
    "build": "run-s build:*",
    "dev:wss": "cross-env PORT=3001 tsx watch src/server/wssDevServer.ts --tsconfig tsconfig.server.json ",
    "dev:next": "next dev",
    "dev": "run-s migrate-dev && run-p dev:*",
    "db-up": "docker-compose up -d",
    "db-seed": "prisma db seed",
    "db-migrate-dev": "prisma migrate dev",
    "db-nuke": "docker-compose down --volumes --remove-orphans",
    "dx": "run-s db-up db-migrate-dev db-seed dev",
    "dev-nuke": "rm -rf prisma/*.db**",
    "generate": "prisma generate",
    "migrate-dev": "prisma migrate dev",
    "migrate": "prisma migrate deploy",
    "start": "cross-env NODE_ENV=production node dist/server/prodServer.js",
    "studio": "prisma studio",
    "lint": "oxlint --type-aware --report-unused-disable-directives-severity=warn src",
    "lint-fix": "lint --fix",
    "test-dev": "cross-env APP_ENV=test start-server-and-test dev 3000 test",
    "test-start": "cross-env APP_ENV=test WS_URL=ws://localhost:3000 start-server-and-test start 3000 test",
    "test": "playwright test",
    "postinstall": "prisma generate"
  },
  "prisma": {
    "seed": "tsx prisma/seed.ts"
  },
  "dependencies": {
    "@prisma/client": "^6.7.0",
    "@shared/ui": "workspace:*",
    "@tanstack/react-query": "^5.107.1",
    "@trpc/client": "npm:@trpc/client",
    "@trpc/next": "npm:@trpc/next",
    "@trpc/react-query": "npm:@trpc/react-query",
    "@trpc/server": "npm:@trpc/server",
    "@vercel/functions": "^3.10.5",
    "clsx": "^2.0.0",
    "cookie": "^1.1.1",
    "lucide-react": "1.70.0",
    "next": "^15.5.29",
    "next-auth": "npm:next-auth@^4.24.15",
    "postgres": "^4.1.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "superjson": "^2.2.6",
    "tsx": "^4.23.15",
    "ws": "^8.22.1",
    "zod": "^4.2.1"
  },
  "devDependencies": {
    "@playwright/test": "^1.65.0",
    "@tailwindcss/postcss": "4.3.5",
    "@tanstack/react-query-devtools": "^5.107.1",
    "@types/node": "^24.19.2",
    "@types/react": "^19.3.0",
    "@types/ws": "^8.18.2",
    "cross-env": "^10.1.0",
    "npm-run-all": "^4.1.5",
    "oxfmt": "^0.75.0",
    "oxlint": "^1.92.0",
    "oxlint-tsgolint": "^7.0.2006",
    "postcss": "^8.5.32",
    "prisma": "^6.7.0",
    "start-server-and-test": "^1.12.0",
    "tailwindcss": "catalog:www",
    "typescript": "^5.9.2"
  },
  "dependenciesMeta": {
    "@shared/ui": {
      "injected": true
    }
  },
  "publishConfig": {
    "access": "restricted"
  }
}
