POSTGRES_URL=postgres://postgres:@0.0.0.0:5432/postgres
# Add `?search_path=<schema>` to use a schema other than `public`
# Set when POSTGRES_URL goes through a transaction pooler, used for migrations and LISTEN
# DIRECT_URL=
AUTH_SECRET=secret
# Without these, a mocked GitHub provider lets you sign in with any name
# AUTH_GITHUB_ID=
# AUTH_GITHUB_SECRET=
