{
  "name": "examples-next-websockets-encoder",
  "private": true,
  "engines": {
    "node": ">=20.9.0"
  },
  "packageManager": "pnpm@10.33.1",
  "scripts": {
    "build:1-next": "cross-env NODE_ENV=production next build",
    "build:2-server": "tsc --project tsconfig.server.json",
    "build": "run-s build:*",
    "dev:wss": "cross-env PORT=3001 tsx watch src/server/wssDevServer.ts --tsconfig tsconfig.server.json",
    "dev:next": "next dev",
    "dev": "run-p dev:*",
    "start": "cross-env NODE_ENV=production node dist/server/prodServer.js",
    "lint": "oxlint src",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@msgpack/msgpack": "^3.1.3",
    "@tanstack/react-query": "^5.107.1",
    "@trpc/client": "npm:@trpc/client",
    "@trpc/next": "npm:@trpc/next",
    "@trpc/react-query": "npm:@trpc/react-query",
    "@trpc/server": "npm:@trpc/server",
    "next": "^16.4.5",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "tsx": "^4.23.15",
    "ws": "^8.22.1",
    "zod": "^4.2.1"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "4.3.5",
    "@tanstack/react-query-devtools": "^5.107.1",
    "@types/node": "^24.19.2",
    "@types/react": "^19.3.0",
    "@types/ws": "^8.18.2",
    "cross-env": "^10.1.0",
    "npm-run-all": "^4.1.5",
    "oxlint": "^1.92.0",
    "oxlint-tsgolint": "^7.0.2006",
    "postcss": "^8.5.32",
    "tailwindcss": "^4.3.5",
    "typescript": "^5.9.2"
  },
  "publishConfig": {
    "access": "restricted"
  }
}
