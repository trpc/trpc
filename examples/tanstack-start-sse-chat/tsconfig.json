{
  "compilerOptions": {
    /* Base Options: */
    "skipLibCheck": true,
    "target": "es2022",
    "allowJs": true,
    "moduleDetection": "force",
    "isolatedModules": true,

    /* Strictness */
    "strict": true,
    "checkJs": true,
    "noUncheckedIndexedAccess": true,
    "allowImportingTsExtensions": true,

    /* Bundled projects */
    "lib": ["dom", "dom.iterable", "ES2023"],
    "noEmit": true,
    "module": "Preserve",
    "moduleResolution": "bundler",
    "jsx": "react-jsx",
    "types": ["node", "vite/client"],

    /* Path aliases */
    "paths": {
      "~/*": ["./src/*"],
      // In this monorepo, the linked `@trpc/tanstack-react-query` would otherwise see its own copy
      "@tanstack/react-query": ["./node_modules/@tanstack/react-query"]
    }
  },
  "include": ["src", "*.ts", "*.js"],
  "exclude": ["node_modules"]
}
