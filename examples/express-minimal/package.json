{
  "name": "examples-express-minimal",
  "private": true,
  "type": "module",
  "scripts": {
    "dev:server": "tsx watch src/server",
    "dev:client": "wait-port 3000 && tsx watch src/client",
    "dev": "run-p dev:* --print-label",
    "lint": "oxlint src",
    "typecheck": "tsc",
    "build": "esbuild src/server.ts src/client.ts --bundle --packages=external --platform=node --format=esm --outdir=dist --sourcemap",
    "start": "pnpm dev"
  },
  "dependencies": {
    "@trpc/client": "npm:@trpc/client",
    "@trpc/react-query": "npm:@trpc/react-query",
    "@trpc/server": "npm:@trpc/server",
    "express": "^5.3.0",
    "zod": "^4.2.1"
  },
  "alias": {
    "scheduler/tracing": "../../node_modules/scheduler/tracing-profiling"
  },
  "devDependencies": {
    "@types/express": "^5.0.6",
    "@types/node": "^24.19.2",
    "@types/react": "^19.3.0",
    "esbuild": "^0.28.2",
    "npm-run-all2": "catalog:",
    "oxlint": "^1.92.0",
    "oxlint-tsgolint": "^7.0.2006",
    "tsx": "^4.23.15",
    "typescript": "^5.9.2",
    "wait-port": "^1.1.0"
  },
  "publishConfig": {
    "access": "restricted"
  }
}
