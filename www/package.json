{
  "name": "www",
  "version": "0.0.0",
  "private": true,
  "description": "trpc.io: the tRPC v11 docs, with the v10 and v9 docs and the blog",
  "type": "module",
  "exports": {
    "./site": "./src/site.ts"
  },
  "scripts": {
    "build": "pnpm typedoc && vite build && node build/vercel-output.ts",
    "dev": "pnpm typedoc && vite dev --port 3000",
    "start": "vite preview --port 3000",
    "lint": "oxlint src build",
    "test": "vitest run",
    "typecheck": "tsc && pnpm --filter @samples/v11 --filter @shared/ui typecheck",
    "typedoc": "pnpm --filter @www/api-reference generate",
    "check-twoslash": "node build/twoslash-check.ts",
    "not-found:check": "node not-found-check.ts",
    "sponsors:sync": "node build/sponsors-sync.ts",
    "sponsors:readme": "node build/sponsors-sync.ts --readme-only"
  },
  "dependencies": {
    "@docsearch/css": "4.7.0",
    "@docsearch/react": "4.7.0",
    "@sentry/tanstackstart-react": "11.8.0",
    "@shared/ui": "workspace:*",
    "@tanstack/react-router": "catalog:www",
    "@tanstack/react-start": "catalog:www",
    "d3-hierarchy": "3.1.2",
    "lucide-react": "1.55.0",
    "minisearch": "7.2.0",
    "next-themes": "0.4.6",
    "react": "catalog:www",
    "react-dom": "catalog:www",
    "sonner": "2.0.8"
  },
  "devDependencies": {
    "@effect/platform-node": "4.1.1",
    "@effect/vitest": "4.1.1",
    "@fontsource/inter": "5.3.0",
    "@fontsource/jetbrains-mono": "5.3.0",
    "@resvg/resvg-js": "2.6.2",
    "@samples/v11": "workspace:*",
    "@shikijs/rehype": "4.5.0",
    "@shikijs/twoslash": "4.5.0",
    "@tailwindcss/typography": "0.5.20",
    "@tailwindcss/vite": "4.3.3",
    "@trpc/client": "workspace:*",
    "@trpc/next": "workspace:*",
    "@trpc/react-query": "workspace:*",
    "@trpc/server": "workspace:*",
    "@trpc/tanstack-react-query": "workspace:*",
    "@types/d3-hierarchy": "3.1.7",
    "@types/hast": "3.0.5",
    "@types/mdast": "4.0.4",
    "@types/node": "catalog:",
    "@types/react": "catalog:www",
    "@types/react-dom": "catalog:www",
    "@vitejs/plugin-react": "catalog:www",
    "@www/api-reference": "workspace:*",
    "effect": "catalog:www",
    "github-slugger": "2.0.0",
    "hast-util-to-html": "9.0.5",
    "hast-util-to-string": "3.0.1",
    "oxlint": "catalog:",
    "oxlint-tsgolint": "catalog:",
    "playwright-core": "1.64.1",
    "rehype-raw": "7.0.0",
    "remark-gfm": "4.0.1",
    "remark-parse": "11.0.0",
    "remark-rehype": "11.1.2",
    "satori": "0.62.0",
    "shiki": "4.5.0",
    "tailwindcss": "catalog:www",
    "twoslash": "0.3.9",
    "typescript": "catalog:",
    "typescript6": "npm:typescript@6.0.3",
    "unified": "11.0.5",
    "unist-util-visit": "5.1.0",
    "vite": "catalog:",
    "vitest": "catalog:",
    "yaml": "2.9.1"
  },
  "engines": {
    "node": "^24.11.0"
  }
}
