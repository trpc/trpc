{
  "name": "www",
  "version": "0.0.0",
  "private": true,
  "description": "trpc.io: the tRPC v12 and v11 docs, with the v10 and v9 docs and the blog",
  "type": "module",
  "exports": {
    "./site": "./src/site.ts"
  },
  "scripts": {
    "build": "pnpm typedoc && vite build && node build/vercel-output.ts && node build/legacy-urls-check.ts",
    "dev": "pnpm typedoc && vite dev --port 3000",
    "start": "vite preview --port 3000",
    "lint": "oxlint src build",
    "test": "vitest run",
    "typecheck": "tsc",
    "typedoc": "pnpm --filter @www/api-reference generate",
    "smoke": "node smoke.ts",
    "check-legacy-urls": "node build/legacy-urls-check.ts",
    "check-twoslash": "node build/twoslash-check.ts",
    "codemod-playground:check": "node codemod-playground-check.ts",
    "decisions:check": "node build/decisions-check.ts",
    "decisions:layout": "node decisions-layout.ts",
    "not-found:check": "node not-found-check.ts",
    "search:check": "node search-check.ts",
    "sentry:smoke": "node sentry-smoke.ts",
    "v12-reveal:check": "node v12-reveal-check.ts",
    "sponsors:sync": "node build/sponsors-sync.ts",
    "sponsors:readme": "node build/sponsors-sync.ts --readme-only"
  },
  "dependencies": {
    "@codemirror/autocomplete": "6.20.3",
    "@codemirror/commands": "6.11.1",
    "@codemirror/lang-javascript": "6.2.5",
    "@codemirror/language": "6.13.1",
    "@codemirror/lint": "6.9.7",
    "@codemirror/state": "6.7.6",
    "@codemirror/view": "6.43.14",
    "@fontsource/inter": "5.3.0",
    "@fontsource/jetbrains-mono": "5.3.0",
    "@hookform/resolvers": "5.9.2",
    "@lezer/highlight": "1.2.5",
    "@oxc-parser/binding-wasm32-wasip1": "0.154.0",
    "@resvg/resvg-wasm": "catalog:www",
    "@sentry/tanstackstart-react": "11.8.0",
    "@shared/ui": "workspace:*",
    "@tanstack/react-query": "5.104.1",
    "@tanstack/react-router": "catalog:www",
    "@tanstack/react-start": "catalog:www",
    "@trpc12/tanstack-react-query": "workspace:*",
    "@trpc12/trpc": "workspace:*",
    "@trpc12/upgrade": "workspace:*",
    "d3-hierarchy": "3.1.2",
    "lucide-react": "1.55.0",
    "minisearch": "7.2.0",
    "next-themes": "0.4.6",
    "react": "catalog:www",
    "react-dom": "catalog:www",
    "react-hook-form": "7.90.0",
    "satori": "0.62.0",
    "sonner": "2.0.8",
    "sucrase": "3.35.1",
    "zod": "catalog:www"
  },
  "devDependencies": {
    "@effect/platform-node": "4.1.1",
    "@effect/vitest": "4.1.1",
    "@resvg/resvg-js": "2.6.2",
    "@samples/kitchen-sink-files": "workspace:*",
    "@samples/kitchen-sink-forms": "workspace:*",
    "@samples/kitchen-sink-optimistic": "workspace:*",
    "@samples/kitchen-sink-realtime": "workspace:*",
    "@samples/v11": "workspace:*",
    "@samples/v12": "workspace:*",
    "@shikijs/rehype": "4.5.0",
    "@shikijs/twoslash": "4.5.0",
    "@tailwindcss/typography": "0.5.20",
    "@tailwindcss/vite": "4.3.3",
    "@tooling/decisions": "workspace:*",
    "@trpc/client": "workspace:*",
    "@trpc/next": "workspace:*",
