    "@trpc/server": "workspace:*",
    "@trpc/tanstack-react-query": "workspace:*",
    "@types/d3-hierarchy": "3.1.7",
    "@types/hast": "3.0.5",
    "@types/mdast": "4.0.4",
    "@types/node": "catalog:",
    "@types/react": "catalog:www",
    "@types/react-dom": "catalog:www",
    "@vitejs/plugin-react": "catalog:www",
    "@www/api-reference": "workspace:*",
    "effect": "catalog:www",
    "github-slugger": "2.0.0",
    "hast-util-to-html": "9.0.5",
    "hast-util-to-string": "3.0.1",
    "oxlint": "catalog:",
    "oxlint-tsgolint": "catalog:",
    "playwright-core": "1.64.1",
    "rehype-raw": "7.0.0",
    "remark-gfm": "4.0.1",
    "remark-parse": "11.0.0",
    "remark-rehype": "11.1.2",
    "shiki": "4.5.0",
    "tailwindcss": "catalog:www",
