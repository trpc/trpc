{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "config:recommended",
    ":preserveSemverRanges",
    "group:allNonMajor",
    "schedule:weekly"
  ],
  "minimumReleaseAge": "7 days",
  "lockFileMaintenance": {
    "enabled": true,
    "schedule": ["before 6am on monday"]
  },
  "vulnerabilityAlerts": {
    "schedule": ["at any time"],
    "minimumReleaseAge": null
  },
  "ignorePaths": ["**/node_modules/**"],
  "ignoreDeps": ["@swc/core", "autofix-ci/action"],
  "updateInternalDeps": true,
  "nvm": {
    "enabled": false
  },
  "npm": {
    "rollbackPrs": false
  },
  "packageRules": [
    {
      "matchDatasources": ["node-version"],
      "enabled": false
    },
    {
      "matchPackageNames": ["pnpm"],
      "enabled": false
    },
    {
      "description": "Examples get minor and patch updates only; move them across majors by hand",
      "matchFileNames": ["examples/**"],
      "matchUpdateTypes": ["major"],
      "enabled": false
    },
    {
      "matchUpdateTypes": ["minor", "patch"],
      "matchDepTypes": ["devDependencies"],
      "automerge": true,
      "platformAutomerge": true
    },
    {
      "description": "@trpc/react-query tests against zod 3 through this alias",
      "matchFileNames": ["packages/react-query/package.json"],
      "matchDepNames": ["zod"],
      "allowedVersions": "<4"
    }
  ]
}
