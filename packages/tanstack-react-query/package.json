{
  "name": "@trpc/tanstack-react-query",
  "type": "module",
  "version": "11.25.2",
  "description": "TanStack React Query Integration for tRPC",
  "author": "juliusmarminge",
  "license": "MIT",
  "main": "./dist/index.cjs",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.cts",
  "homepage": "https://trpc.io/docs/client/tanstack-react-query/setup",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/trpc/trpc.git",
    "directory": "packages/tanstack-react-query"
  },
  "scripts": {
    "build": "tsdown",
    "prepack": "node ../../www/build/skills.ts --package .",
    "dev": "tsdown --watch",
    "lint": "oxlint src",
    "typecheck": "tsc --noEmit --preserveWatchOutput --pretty"
  },
  "exports": {
    "./package.json": "./package.json",
    ".": {
      "react-server": {
        "import": {
          "types": "./dist/index.react-server.d.mts",
          "default": "./dist/index.react-server.mjs"
        },
        "require": {
          "types": "./dist/index.react-server.d.cts",
          "default": "./dist/index.react-server.cjs"
        }
      },
      "import": {
        "types": "./dist/index.d.mts",
        "default": "./dist/index.mjs"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    },
    "./unstable-handles": {
      "import": {
        "types": "./dist/unstable-handles/index.d.mts",
        "default": "./dist/unstable-handles/index.mjs"
      },
      "require": {
        "types": "./dist/unstable-handles/index.d.cts",
        "default": "./dist/unstable-handles/index.cjs"
      }
    }
  },
  "files": [
    "dist",
    "src",
    "README.md",
    "package.json",
    "unstable-handles",
    "!**/*.test.*",
    "!**/__tests__",
    "skills"
  ],
  "peerDependencies": {
    "@tanstack/react-query": "^5.80.3",
    "@trpc/client": "11.25.2",
    "@trpc/server": "11.25.2",
    "react": ">=18.2.0",
    "typescript": ">=5.7.2"
  },
  "devDependencies": {
    "@tanstack/intent": "0.5.6",
    "@tanstack/react-query": "^5.107.1",
    "@trpc/client": "workspace:*",
    "@trpc/server": "workspace:*",
    "@types/node": "catalog:",
    "@types/react": "^19.3.0",
    "event-source-polyfill": "^1.0.31",
    "konn": "^0.7.0",
    "oxlint": "catalog:",
    "oxlint-tsgolint": "catalog:",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "superjson": "^1.12.4",
    "tsdown": "catalog:",
    "typescript": "catalog:",
    "vitest": "catalog:",
    "ws": "catalog:",
    "zod": "^4.2.1"
  },
  "publishConfig": {
    "access": "public"
  },
  "funding": [
    "https://trpc.io/sponsor"
  ],
  "keywords": [
    "tanstack-intent"
  ]
}
