{
  "extends": "../../tsconfig.json",
  "include": [
    "server",
    "showcase",
    "suppressActWarnings.ts",
    "vitest.config.mts"
  ],
  "compilerOptions": {
    "skipLibCheck": true,
    "lib": ["ES2023", "DOM", "DOM.Iterable"],
