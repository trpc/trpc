{
  "name": "@trpc/upgrade",
  "version": "11.28.1",
  "description": "Upgrade scripts for tRPC",
  "author": "juliusmarminge",
  "license": "MIT",
  "type": "module",
  "bin": "./dist/bin.mjs",
  "homepage": "https://trpc.io",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/trpc/trpc.git",
    "directory": "packages/upgrade"
  },
  "exports": {
    "./transforms/hooksToOptions": {
      "require": "./dist/transforms/hooksToOptions.cjs"
    },
    "./transforms/provider": {
      "require": "./dist/transforms/provider.cjs"
    }
  },
  "scripts": {
    "build": "tsdown"
  },
  "files": [
    "dist",
    "src",
    "README.md",
    "package.json",
    "!**/*.test.*",
    "!**/__tests__"
  ],
  "dependencies": {
    "@bomb.sh/args": "0.3.1",
    "@clack/prompts": "1.8.1",
    "jscodeshift": "17.4.0",
    "typescript": "catalog:"
  },
  "devDependencies": {
    "@tanstack/react-query": "catalog:",
    "@trpc/client": "workspace:*",
    "@trpc/react-query": "workspace:*",
    "@trpc/server": "workspace:*",
    "@trpc/tanstack-react-query": "workspace:*",
    "@types/jscodeshift": "17.3.0",
    "@types/node": "catalog:",
    "oxfmt": "catalog:",
    "react": "catalog:",
    "react-dom": "catalog:",
    "tsdown": "catalog:",
    "zod": "catalog:"
  },
  "publishConfig": {
    "access": "public"
  },
  "funding": [
    "https://trpc.io/sponsor"
  ]
}
