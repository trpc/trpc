{
  "name": "@trpc/react-query",
  "type": "module",
  "version": "11.28.2",
  "description": "The tRPC React library",
  "author": "KATT",
  "license": "MIT",
  "main": "./dist/index.cjs",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.cts",
  "homepage": "https://trpc.io",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/trpc/trpc.git",
    "directory": "packages/react"
  },
  "scripts": {
    "build": "tsdown",
    "dev": "tsdown --watch",
    "lint": "oxlint src",
    "typecheck": "tsc --noEmit --preserveWatchOutput --pretty"
  },
  "exports": {
    "./package.json": "./package.json",
    ".": {
      "import": {
        "types": "./dist/index.d.mts",
        "default": "./dist/index.mjs"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    },
    "./rsc": {
      "import": {
        "types": "./dist/rsc.d.mts",
        "default": "./dist/rsc.mjs"
      },
      "require": {
        "types": "./dist/rsc.d.cts",
        "default": "./dist/rsc.cjs"
      }
    },
    "./server": {
      "import": {
        "types": "./dist/server/index.d.mts",
        "default": "./dist/server/index.mjs"
      },
      "require": {
        "types": "./dist/server/index.d.cts",
        "default": "./dist/server/index.cjs"
      }
    },
    "./shared": {
      "import": {
        "types": "./dist/shared/index.d.mts",
        "default": "./dist/shared/index.mjs"
      },
      "require": {
        "types": "./dist/shared/index.d.cts",
        "default": "./dist/shared/index.cjs"
      }
    }
  },
  "files": [
    "dist",
    "src",
    "README.md",
    "package.json",
    "rsc",
    "server",
    "shared",
    "!**/*.test.*",
    "!**/__tests__"
  ],
  "peerDependencies": {
    "@tanstack/react-query": "^5.80.3",
    "@trpc/client": "11.28.2",
    "@trpc/server": "11.28.2",
    "react": ">=18.2.0",
    "typescript": ">=5.7.2"
  },
  "devDependencies": {
    "@tanstack/query-sync-storage-persister": "^5.107.1",
    "@tanstack/react-query": "catalog:",
    "@tanstack/react-query-persist-client": "^5.107.1",
    "@testing-library/dom": "catalog:",
    "@testing-library/jest-dom": "catalog:",
    "@testing-library/react": "catalog:",
    "@testing-library/user-event": "catalog:",
    "@trpc/client": "workspace:*",
    "@trpc/server": "workspace:*",
    "@types/express": "catalog:",
    "@types/node": "catalog:",
    "@types/react": "catalog:",
    "express": "catalog:",
    "next": "catalog:",
    "oxlint": "catalog:",
    "oxlint-tsgolint": "catalog:",
    "react": "catalog:",
    "react-dom": "catalog:",
    "tsdown": "catalog:",
    "tslib": "catalog:",
    "typescript": "catalog:",
    "zod": "npm:zod@^3.0.0",
    "zod-form-data": "npm:zod-form-data@^2.0.1"
  },
  "publishConfig": {
    "access": "public"
  },
  "funding": [
    "https://trpc.io/sponsor"
  ]
}
