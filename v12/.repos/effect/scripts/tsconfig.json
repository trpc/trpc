{
  "$schema": "https://json.schemastore.org/tsconfig",
  "extends": "../tsconfig.base.json",
  "include": ["**/*.ts"],
  "compilerOptions": {
    "noEmit": true,
    "declaration": false,
    "declarationMap": false,
    "composite": false,
    "incremental": false,
    "plugins": [
      {
        "name": "@effect/language-service",
        "effectFn": ["untraced"],
        "namespaceImportPackages": [],
        "diagnosticSeverity": { "effectFnOpportunity": "error" }
      }
    ]
  }
}
