+/**
+ * A 403 on a publish (PUT) can come from a proxy/WAF in front of the registry
+ * rather than from npm itself, in which case the response is an HTML page left
+ * as a raw Buffer on `err.body`. Normal error handling only reads
+ * `err.body?.error` (set for JSON bodies), so that page is never shown and the
+ * failure reads as a bare "403 Forbidden". Log it in full, and only here.
+ */
+function logForbiddenPutBody(err) {
+  if (err?.statusCode !== 403 || err?.method !== 'PUT' || !Buffer.isBuffer(err.body)) {
+    return;
+  }
+  log.error(err.code, `response body for PUT ${err.uri}:\n${err.body.toString('utf8')}`);
+}
