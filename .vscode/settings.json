{
  // vNext tooling (Oxc via Vite+) only runs when `trpc.code-workspace` is open.
  "editor.defaultFormatter": "oxc.oxc-vscode",
  "[javascript]": { "editor.defaultFormatter": "oxc.oxc-vscode" },
  "[javascriptreact]": { "editor.defaultFormatter": "oxc.oxc-vscode" },
  "[typescript]": { "editor.defaultFormatter": "oxc.oxc-vscode" },
  "[typescriptreact]": { "editor.defaultFormatter": "oxc.oxc-vscode" },
  "[json]": { "editor.defaultFormatter": "oxc.oxc-vscode" },
  "[jsonc]": { "editor.defaultFormatter": "oxc.oxc-vscode" },
  "[markdown]": { "editor.defaultFormatter": "oxc.oxc-vscode" },
  "editor.formatOnSave": true,
  "editor.formatOnSaveMode": "file",
  "editor.codeActionsOnSave": {
    "source.fixAll.oxc": "explicit"
  },
  "eslint.enable": false,
  "prettier.enable": false,
  "search.exclude": {
    "/v11/www/versioned_docs": true,
    "/v11/www/.docusaurus": true,
    "/v11/www/build": true,
    "**/dist": true,
    "**/.repos": true
  },
  "files.watcherExclude": {
    "**/.repos/**": true
  },
  "files.exclude": {
    "**/.repos": true
  },
  "workbench.colorCustomizations": {
    "titleBar.activeBackground": "#2596be",
    "titleBar.activeForeground": "#ffffff",
    "titleBar.inactiveBackground": "#004a72",
    "titleBar.inactiveForeground": "#639db2"
  },
  "editor.stickyScroll.enabled": true,
  "js/ts.experimental.useTsgo": true,
  "js/ts.preferences.autoImportFileExcludePatterns": ["**/.repos/**"]
}
