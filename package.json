{
  "name": "trpc-repo",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@12.4.1",
  "engines": {
    "node": "^26.0.0",
    "pnpm": "^12.0.0"
  },
  "scripts": {
    "build": "turbo run build --filter=!root --filter=!trpc-next --filter='!./v11/examples/**'",
    "typecheck": "turbo run typecheck --filter=!trpc-next --filter='!./v11/examples/**'",
    "lint": "turbo run lint --filter=!root",
    "test": "turbo run test --filter=root --filter=trpc-next --filter=www --concurrency=1",
    "check:www": "turbo run lint typecheck test --filter='!root' --filter='!trpc-next' --filter='!./v11/**' --filter='!./next/**'",
    "format": "oxfmt --check",
    "format-fix": "oxfmt",
    "next": "pnpm -C next",
    "v11": "pnpm -C v11",
    "www": "pnpm -C www"
  },
  "devDependencies": {
    "oxfmt": "catalog:",
    "oxlint": "catalog:",
    "oxlint-tsgolint": "catalog:",
    "tsx": "^4.23.15",
    "turbo": "catalog:",
    "typescript": "catalog:ts-api",
    "vite": "catalog:"
  }
}
