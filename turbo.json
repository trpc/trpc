{
  "$schema": "https://turborepo.org/schema.json",
  // `root` (v11/) and `trpc-next` (v12/) are packages that hold packages:
  // their own `build`, `lint` and `typecheck` run turbo on what they hold,
  // so the root's scripts leave them out (`--filter=!root`), and only their
  // `test`, one Vitest run each over everything they hold, is a task here.
  "globalDependencies": [
    ".oxlintrc.json",
    "v11/.oxlintrc.json",
    "v11/tooling/oxlint-plugin/**",
    "v11/tsconfig.json",
    "v11/tsconfig.build.json",
    "v11/scripts/**"
  ],
  "globalEnv": [
    "CI",
    "NODE_ENV",
    "DATABASE_URL",
    "DIRECT_URL",
    "APP_URL",
    "WS_URL",
    "NEXTAUTH_SECRET",
    "AUTH_GITHUB_ID",
    "AUTH_GITHUB_SECRET",
    "VERCEL_ENV",
    "VERCEL_BRANCH_URL",
    "VERCEL_PROJECT_PRODUCTION_URL"
  ],
  // Read by the tools a task runs, not by what it makes.
  "globalPassThroughEnv": [
    "CHROME_PATH",
    "GITHUB_ACTIONS",
    "GITHUB_TOKEN",
    "PLAYWRIGHT_*",
    "RUNNER_*",
    "VP_*"
  ],
  "tasks": {
    "prebuild": {
      "cache": false
    },
    "build": {
      "dependsOn": ["^build", "prebuild"],
      "outputs": [
        ".next/**",
        "!.next/cache/**",
        "dist/**",
        "build/**",
        "docs/typedoc/**"
      ]
    },
    "www#build": {
      "dependsOn": ["^build", "prebuild"],
      "env": [
        "NEXT_PUBLIC_SENTRY_DSN",
        "SENTRY_*",
        "VERCEL",
        "VERCEL_GIT_COMMIT_REF",
        "VERCEL_GIT_COMMIT_SHA",
        "VERCEL_URL",
        "GITHUB_REF_NAME",
        "GITHUB_SHA"
      ],
      // The decisions pages render v12's design docs; the benchmarks page, the
      // oRPC parity matrix's feature tables.
      "inputs": [
        "$TURBO_DEFAULT$",
        "$TURBO_ROOT$/v12/.agent-docs/open/**",
        "$TURBO_ROOT$/v12/.agent-docs/decisions/**",
        "$TURBO_ROOT$/v12/.agent-docs/reference/orpc-parity.md"
      ],
      "outputs": [".vercel/output/**", "dist/**"]
    },
    // These three run their `client/` and `server/` packages' scripts with
    // `npm run -w`, so turbo can't see what those depend on.
    "examples-minimal-react#build": {
      "dependsOn": [
        "@trpc/client#build",
        "@trpc/server#build",
        "@trpc/tanstack-react-query#build"
      ],
      "outputs": ["client/dist/**", "server/dist/**"]
    },
    "examples-minimal-content-types#build": {
      "dependsOn": [
        "@trpc/client#build",
        "@trpc/react-query#build",
        "@trpc/server#build"
      ],
      "outputs": ["client/dist/**", "server/dist/**"]
    },
    "examples-minimal-per-procedure-errors#build": {
      "dependsOn": [
        "@trpc/client#build",
        "@trpc/server#build",
        "@trpc/tanstack-react-query#build"
      ],
      "outputs": ["client/dist/**", "server/dist/**"]
    },
    "examples-minimal-per-procedure-errors#typecheck": {
      "dependsOn": [
        "@trpc/client#build",
        "@trpc/server#build",
        "@trpc/tanstack-react-query#build"
      ]
    },
    "examples-tanstack-start-sse-chat#build": {
      "dependsOn": ["^build", "prebuild"],
      "outputs": [".output/**", ".vercel/output/**"]
    },
    "dev": {
      "cache": false,
      "persistent": true
    },
    "lint": {
      "dependsOn": ["^build"],
      "outputs": [],
      "cache": true
    },
    "lint-fix": {
      "cache": false
    },
    "test-dev": {
      "dependsOn": ["^build"]
    },
    "typecheck": {
      "dependsOn": ["^build"]
    },
    // It reads `www/site`'s source, and has no `lint`: building the site
    // would only slow these.
    "@tooling/pack#typecheck": {},
    "@tooling/pack#lint": {},
    "test-start": {
      "dependsOn": ["^build", "build"]
    },
    "test": {
      "dependsOn": ["^build"],
      "env": ["REDIS_URL", "MUTE_REACT_ACT_WARNINGS"],
      "outputs": ["coverage/**"]
    },
    "www#test": {
      "dependsOn": ["^build"],
      "outputs": []
    },
    // One run over every package in v11/ or v12/: the packages' npm
    // dependencies are in the lockfile, not in either's package.json.
    "root#test": {
      "env": ["REDIS_URL", "MUTE_REACT_ACT_WARNINGS"],
      "inputs": [
        "$TURBO_DEFAULT$",
        "$TURBO_ROOT$/pnpm-lock.yaml",
        "$TURBO_ROOT$/pnpm-workspace.yaml"
      ],
      "outputs": []
    },
    "trpc-next#lint": {
      "dependsOn": ["^build"],
      "inputs": [
        "$TURBO_DEFAULT$",
        "$TURBO_ROOT$/pnpm-lock.yaml",
        "$TURBO_ROOT$/pnpm-workspace.yaml"
      ],
      "outputs": []
    },
    // `test` is every project, `coverage` the packages' and `test:rest` the
    // others'. `tooling/pack/docs.test.ts` checks v12's docs list every package.
    "trpc-next#test": {
      "env": ["REDIS_URL", "DATABASE_URL"],
      "inputs": [
        "$TURBO_DEFAULT$",
        "$TURBO_ROOT$/pnpm-lock.yaml",
        "$TURBO_ROOT$/pnpm-workspace.yaml",
        "$TURBO_ROOT$/www/v12/docs/**",
        "$TURBO_ROOT$/www/src/site.ts"
      ],
      "outputs": ["coverage/**"]
    },
    "trpc-next#coverage": {
      "env": ["REDIS_URL"],
      "inputs": [
        "$TURBO_DEFAULT$",
        "$TURBO_ROOT$/pnpm-lock.yaml",
        "$TURBO_ROOT$/pnpm-workspace.yaml",
        "$TURBO_ROOT$/www/v12/docs/**",
        "$TURBO_ROOT$/www/src/site.ts"
      ],
      "outputs": ["coverage/**"]
    },
    "trpc-next#test:rest": {
      "env": ["REDIS_URL", "DATABASE_URL"],
      "inputs": [
        "$TURBO_DEFAULT$",
        "$TURBO_ROOT$/pnpm-lock.yaml",
        "$TURBO_ROOT$/pnpm-workspace.yaml",
        "$TURBO_ROOT$/www/v12/docs/**",
        "$TURBO_ROOT$/www/src/site.ts"
      ],
      "outputs": []
    }
  }
}
