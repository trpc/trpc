{
  "$schema": "https://turborepo.org/schema.json",
  "globalDependencies": [
    ".oxlintrc.json",
    "tooling/oxlint-plugin/**",
    "tsconfig.json",
    "tsconfig.build.json",
    "scripts/**"
  ],
  "globalEnv": [
    "CI",
    "NODE_ENV",
    "DATABASE_URL",
    "DIRECT_URL",
    "APP_URL",
    "WS_URL",
    "NEXTAUTH_SECRET",
    "AUTH_GITHUB_ID",
    "AUTH_GITHUB_SECRET",
    "VERCEL_ENV",
    "VERCEL_BRANCH_URL",
    "VERCEL_PROJECT_PRODUCTION_URL"
  ],
  "tasks": {
    "prebuild": {
      "cache": false
    },
    "build": {
      "dependsOn": ["^build", "prebuild"],
      "outputs": [
        ".next/**",
        "!.next/cache/**",
        "dist/**",
        "build/**",
        "docs/typedoc/**"
      ]
    },
    "www#build": {
      "dependsOn": ["^build", "prebuild"],
      "env": [
        "NEXT_PUBLIC_SENTRY_DSN",
        "SENTRY_*",
        "VERCEL",
        "VERCEL_GIT_COMMIT_REF",
        "VERCEL_GIT_COMMIT_SHA",
        "VERCEL_URL",
        "GITHUB_REF_NAME",
        "GITHUB_SHA"
      ],
      "outputs": [".vercel/output/**", "dist/**"]
    },
    "examples-minimal-react#build": {
      "outputs": ["client/dist/**", "server/dist/**"]
    },
    "examples-tanstack-start-sse-chat#build": {
      "dependsOn": ["^build", "prebuild"],
      "outputs": [".output/**", ".vercel/output/**"]
    },
    "examples-minimal-per-procedure-errors#build": {
      "outputs": ["client/dist/**", "server/dist/**"]
    },
    "dev": {
      "cache": false,
      "persistent": true
    },
    "lint": {
      "dependsOn": ["^build"],
      "outputs": [],
      "cache": true
    },
    "lint-fix": {
      "cache": false
    },
    "test-dev": {
      "dependsOn": ["^build"]
    },
    "typecheck": {
      "dependsOn": ["^build"]
    },
    "test-start": {
      "dependsOn": ["^build", "build"]
    }
  }
}
