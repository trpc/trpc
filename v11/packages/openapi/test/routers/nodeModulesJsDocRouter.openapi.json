{
  "openapi": "3.1.1",
  "jsonSchemaDialect": "https://spec.openapis.org/oas/3.1/dialect/base",
  "info": {
    "title": "tRPC API",
    "version": "0.0.0"
  },
  "paths": {
    "/monorepoImport": {
      "get": {
        "operationId": "monorepoImport",
        "tags": [
          "monorepoImport"
        ],
        "responses": {
          "200": {
            "description": "Successful response",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "result": {
                      "type": "object",
                      "properties": {
                        "data": {
                          "$ref": "#/components/schemas/MonorepoImportOutput"
                        }
                      },
                      "required": [
                        "data"
                      ]
                    }
                  },
                  "required": [
                    "result"
                  ]
                }
              }
            }
          },
          "default": {
            "$ref": "#/components/responses/Error"
          }
        }
      }
    },
    "/localNodeModulesImport": {
      "get": {
        "operationId": "localNodeModulesImport",
        "tags": [
          "localNodeModulesImport"
        ],
        "responses": {
          "200": {
            "description": "Successful response",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "result": {
                      "type": "object",
                      "properties": {
                        "data": {
                          "$ref": "#/components/schemas/LocalNodeModulesImportOutput"
                        }
                      },
                      "required": [
                        "data"
                      ]
                    }
                  },
                  "required": [
                    "result"
                  ]
                }
              }
            }
          },
          "default": {
            "$ref": "#/components/responses/Error"
          }
        }
      }
    },
    "/rootNodeModulesImport": {
      "get": {
        "operationId": "rootNodeModulesImport",
        "tags": [
          "rootNodeModulesImport"
        ],
        "responses": {
          "200": {
            "description": "Successful response",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "result": {
                      "type": "object",
                      "properties": {
                        "data": {
                          "$ref": "#/components/schemas/RootNodeModulesImportOutput"
                        }
                      },
                      "required": [
                        "data"
                      ]
                    }
                  },
                  "required": [
                    "result"
                  ]
                }
              }
            }
          },
          "default": {
            "$ref": "#/components/responses/Error"
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "MonorepoImportOutput": {
        "type": "object",
        "properties": {
          "requestInfo": {
            "$ref": "#/components/schemas/TRPCRequestInfo"
          }
        },
        "required": [
          "requestInfo"
        ],
        "additionalProperties": false
      },
      "TRPCRequestInfo": {
        "type": "object",
        "properties": {
          "accept": {
            "oneOf": [
              {
                "type": "string",
                "const": "application/jsonl"
              },
              {
                "type": "null"
              }
            ],
            "description": "The `trpc-accept` header"
          },
          "type": {
            "type": "string",
            "enum": [
              "query",
              "mutation",
              "subscription",
              "unknown"
            ],
            "description": "The type of the request"
          },
          "isBatchCall": {
            "type": "boolean",
            "description": "If the content type handler has detected that this is a batch call"
          },
          "calls": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/TRPCRequestInfoProcedureCall"
            },
            "description": "The calls being made"
          },
          "connectionParams": {
            "oneOf": [
              {
                "type": "object",
                "additionalProperties": {
                  "type": "string"
                }
              },
              {
                "type": "null"
              }
            ],
            "description": "Connection params when using `httpSubscriptionLink` or `createWSClient`"
          },
          "signal": {
            "$ref": "#/components/schemas/AbortSignal"
          },
          "url": {
            "oneOf": [
              {
                "$ref": "#/components/schemas/URL"
              },
              {
                "type": "null"
              }
            ],
            "description": "The URL of the request if available"
          }
        },
        "required": [
          "accept",
          "type",
          "isBatchCall",
          "calls",
          "connectionParams",
          "signal",
          "url"
        ],
        "additionalProperties": false
      },
      "TRPCRequestInfoProcedureCall": {
        "type": "object",
        "properties": {
          "path": {
            "type": "string"
          },
          "batchIndex": {
            "type": "number",
            "description": "The index of this call in a batch request."
          }
        },
        "required": [
          "path",
          "batchIndex"
        ],
        "additionalProperties": false
      },
      "AbortSignal": {
        "type": "object",
        "properties": {
          "aborted": {
            "type": "boolean"
          },
          "reason": {}
        },
        "required": [
          "aborted",
          "reason"
        ],
        "additionalProperties": false
      },
      "URL": {
        "type": "object",
        "properties": {
          "hash": {
            "type": "string"
          },
          "host": {
            "type": "string"
          },
          "hostname": {
            "type": "string"
          },
          "href": {
            "type": "string"
          },
          "origin": {
            "type": "string"
          },
          "password": {
            "type": "string"
          },
          "pathname": {
            "type": "string"
          },
          "port": {
            "type": "string"
          },
          "protocol": {
            "type": "string"
          },
          "search": {
            "type": "string"
          },
          "searchParams": {
            "$ref": "#/components/schemas/URLSearchParams"
          },
          "username": {
            "type": "string"
          }
        },
        "required": [
          "hash",
          "host",
          "hostname",
          "href",
          "origin",
          "password",
          "pathname",
          "port",
          "protocol",
          "search",
          "searchParams",
          "username"
        ],
        "additionalProperties": false
      },
      "URLSearchParams": {
        "type": "object",
        "properties": {
          "size": {
            "type": "number"
          }
        },
        "required": [
          "size"
        ],
        "additionalProperties": false
      },
      "LocalNodeModulesImportOutput": {
        "type": "object",
        "properties": {
          "diagnostic": {
            "$ref": "#/components/schemas/Diagnostic"
          }
        },
        "required": [
          "diagnostic"
        ],
        "additionalProperties": false
      },
      "Diagnostic": {
        "type": "object",
        "properties": {
          "range": {
            "$ref": "#/components/schemas/Range"
          },
          "severity": {
            "type": "number",
            "enum": [
              3,
              1,
              2,
              4
            ]
          },
          "code": {
            "type": [
              "string",
              "number"
            ]
          },
          "codeDescription": {
            "$ref": "#/components/schemas/CodeDescription"
          },
          "source": {
            "type": "string"
          },
          "message": {
            "type": "string"
          },
          "tags": {
            "type": "array",
            "items": {
              "type": "number",
              "enum": [
                1,
                2
              ]
            }
          },
          "relatedInformation": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/DiagnosticRelatedInformation"
            }
          },
          "data": {}
        },
        "required": [
          "range",
          "message"
        ],
        "additionalProperties": false
      },
      "Range": {
        "type": "object",
        "properties": {
          "start": {
            "$ref": "#/components/schemas/Position"
          },
          "end": {
            "$ref": "#/components/schemas/Position"
          }
        },
        "required": [
          "start",
          "end"
        ],
        "additionalProperties": false
      },
      "Position": {
        "type": "object",
        "properties": {
          "line": {
            "type": "number"
          },
          "character": {
            "type": "number"
          }
        },
        "required": [
          "line",
          "character"
        ],
        "additionalProperties": false
      },
      "CodeDescription": {
        "type": "object",
        "properties": {
          "href": {
            "type": "string"
          }
        },
        "required": [
          "href"
        ],
        "additionalProperties": false
      },
      "DiagnosticRelatedInformation": {
        "type": "object",
        "properties": {
          "location": {
            "$ref": "#/components/schemas/Location"
          },
          "message": {
            "type": "string"
          }
        },
        "required": [
          "location",
          "message"
        ],
        "additionalProperties": false
      },
      "Location": {
        "type": "object",
        "properties": {
          "uri": {
            "type": "string"
          },
          "range": {
            "$ref": "#/components/schemas/Range"
          }
        },
        "required": [
          "uri",
          "range"
        ],
        "additionalProperties": false
      },
      "RootNodeModulesImportOutput": {
        "type": "object",
        "properties": {
          "aliasOptions": {
            "oneOf": [
              {
                "type": "array",
                "items": {
                  "$ref": "#/components/schemas/Alias"
                }
              },
              {
                "type": "object",
                "additionalProperties": {
                  "type": "string"
                }
              }
            ]
          }
        },
        "required": [
          "aliasOptions"
        ],
        "additionalProperties": false
      },
      "Alias": {
        "type": "object",
        "properties": {
          "find": {
            "oneOf": [
              {
                "type": "string"
              },
              {
                "$ref": "#/components/schemas/RegExp"
              }
            ]
          },
          "replacement": {
            "type": "string"
          },
          "customResolver": {
            "oneOf": [
              {
                "$ref": "#/components/schemas/ResolverObject"
              },
              {
                "type": "null"
              }
            ]
          }
        },
        "required": [
          "find",
          "replacement"
        ],
        "additionalProperties": false
      },
      "RegExp": {
        "type": "object",
        "properties": {
          "source": {
            "type": "string"
          },
          "global": {
            "type": "boolean"
          },
          "ignoreCase": {
            "type": "boolean"
          },
          "multiline": {
            "type": "boolean"
          },
          "lastIndex": {
            "type": "number"
          },
          "flags": {
            "type": "string"
          },
          "sticky": {
            "type": "boolean"
          },
          "unicode": {
            "type": "boolean"
          },
          "dotAll": {
            "type": "boolean"
          },
          "hasIndices": {
            "type": "boolean"
          }
        },
        "required": [
          "source",
          "global",
          "ignoreCase",
          "multiline",
          "lastIndex",
          "flags",
          "sticky",
          "unicode",
          "dotAll",
          "hasIndices"
        ],
        "additionalProperties": false
      },
      "ResolverObject": {
        "type": "object",
        "additionalProperties": false
      },
      "DefaultErrorShape": {
        "type": "object",
        "properties": {
          "message": {
            "type": "string"
          },
          "code": {
            "type": "number",
            "enum": [
              -32700,
              -32600,
              -32603,
              -32001,
              -32002,
              -32003,
              -32004,
              -32005,
              -32008,
              -32009,
              -32012,
              -32013,
              -32015,
              -32022,
              -32028,
              -32029,
              -32099
            ]
          },
          "data": {
            "$ref": "#/components/schemas/DefaultErrorData"
          }
        },
        "required": [
          "message",
          "code",
          "data"
        ],
        "additionalProperties": false
      },
      "DefaultErrorData": {
        "type": "object",
        "properties": {
          "code": {
            "type": "string",
            "enum": [
              "PARSE_ERROR",
              "BAD_REQUEST",
              "INTERNAL_SERVER_ERROR",
              "NOT_IMPLEMENTED",
              "BAD_GATEWAY",
              "SERVICE_UNAVAILABLE",
              "GATEWAY_TIMEOUT",
              "UNAUTHORIZED",
              "PAYMENT_REQUIRED",
              "FORBIDDEN",
              "NOT_FOUND",
              "METHOD_NOT_SUPPORTED",
              "TIMEOUT",
              "CONFLICT",
              "PRECONDITION_FAILED",
              "PAYLOAD_TOO_LARGE",
              "UNSUPPORTED_MEDIA_TYPE",
              "UNPROCESSABLE_CONTENT",
              "PRECONDITION_REQUIRED",
              "TOO_MANY_REQUESTS",
              "CLIENT_CLOSED_REQUEST"
            ]
          },
          "httpStatus": {
            "type": "number"
          },
          "path": {
            "type": "string",
            "description": "Path to the procedure that threw the error"
          },
          "stack": {
            "type": "string",
            "description": "Stack trace of the error (only in development)"
          }
        },
        "required": [
          "code",
          "httpStatus"
        ],
        "additionalProperties": false
      }
    },
    "responses": {
      "Error": {
        "description": "Error response",
        "content": {
          "application/json": {
            "schema": {
              "type": "object",
              "properties": {
                "error": {
                  "$ref": "#/components/schemas/DefaultErrorShape"
                }
              },
              "required": [
                "error"
              ]
            }
          }
        }
      }
    }
  }
}
