{
  "extends": "./tsconfig.build.json",
  "include": ["packages", "types", "scripts", "examples"],
  "exclude": [],
  "compilerOptions": {
    "allowJs": false,
    "allowImportingTsExtensions": true,
    "noEmit": true,
    "rootDir": ".",
    "paths": {
      "@trpc/client": ["./packages/client/src"],
      "@trpc/client/*": ["./packages/client/src/*"],
      "@trpc/next": ["./packages/next/src"],
      "@trpc/next/*": ["./packages/next/src/*"],
      "@trpc/react-query": ["./packages/react-query/src"],
      "@trpc/react-query/*": ["./packages/react-query/src/*"],
      "@trpc/openapi": ["./packages/openapi/src"],
      "@trpc/openapi/*": ["./packages/openapi/src/*"],
      "@trpc/server": ["./packages/server/src"],
      "@trpc/server/*": ["./packages/server/src/*"],
      "@trpc/tanstack-react-query": ["./packages/tanstack-react-query/src"],
      "@trpc/tanstack-react-query/*": ["./packages/tanstack-react-query/src/*"],
      // The workspace has a vitest per set of peers, and jest-dom augments
      // whichever is hoisted. The tests run on this one.
      "vitest": ["./node_modules/vitest"],
      "vitest/*": ["./node_modules/vitest/*"]
    },
    "types": ["node", "vitest/globals"]
  }
}
